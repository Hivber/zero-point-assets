<!-- 登录暂时隐藏：认证恢复时再启用 auth-client.js -->
<script type="module">
(async () => {
  const show = (msg) => {
    const st = document.getElementById('loadingStatus');
    if (st) st.textContent = msg;
  };
  try {
    window.__ZP_BOOT_STAGE__ = 'module-import';
    show('正在加载前端模块…');
    const importPromise = import('/main.js?v=celebrate01');
    await Promise.race([
      importPromise,
      new Promise((_, reject) => setTimeout(() => reject(new Error('前端模块加载超时（可能是 Three.js / VRM CDN 无法访问）')), 12000)),
    ]);
    if (!window.__ZP_MAIN_READY__) {
      // main.js 会自行进入 init().catch()，这里仅用于确认模块已成功执行。
      show('前端模块已启动，正在初始化…');
    }
  } catch (e) {
    const detail = String(e?.message || e || '未知模块加载错误');
    window.__ZP_BOOT_STAGE__ = 'module-import-error';
    show('前端模块加载失败：' + detail.slice(0, 180));
    console.error('[BOOT] main.js import failed', e);
  }
})();
</script>
