      saveWorkingTouchLayout();
      updateTouchLayoutControls();
    });
    const endDrag = (e) => {
      if (!touchLayoutDrag || touchLayoutDrag.id !== id) return;
      if (e && e.pointerId !== undefined && e.pointerId !== touchLayoutDrag.pointerId) return;
      touchLayoutDrag = null;
      try { el.releasePointerCapture?.(e.pointerId); } catch (err) {}
    };
    el.addEventListener('pointerup', endDrag);
    el.addEventListener('pointercancel', endDrag);
  }

  window.addEventListener('resize', () => {
    if (!touchLayoutEditing) {
      applySavedTouchLayouts();
