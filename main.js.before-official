function initMinimap() {
  minimapCanvas = document.getElementById('minimap');
  if (!minimapCanvas) return;
  minimapCtx = minimapCanvas.getContext('2d');
  crosshairSpans = document.querySelectorAll('.crosshair span');
}
function drawMinimap() {
  if (!minimapCtx) return;
  const c = minimapCtx;
  const W = minimapCanvas.width, H = minimapCanvas.height;
  const R = W / 2;
  const scale = R / MINIMAP_RANGE;
  const px = player.pos.x, pz = player.pos.z;

  c.clearRect(0, 0, W, H);
  c.save();
  c.beginPath(); c.arc(R, R, R - 2, 0, Math.PI * 2); c.clip();
  c.fillStyle = 'rgba(15,22,30,0.72)';
  c.fillRect(0, 0, W, H);

  c.fillStyle = 'rgba(180,160,110,0.85)';
  for (const w of minimapWalls) {
    const sx = R + (w.x - px) * scale;
    const sy = R + (w.z - pz) * scale;
    const sw = w.w * scale, sh = w.d * scale;
    if (sx + sw/2 < 0 || sx - sw/2 > W) continue;
    if (sy + sh/2 < 0 || sy - sh/2 > H) continue;
    c.fillRect(sx - sw/2, sy - sh/2, sw, sh);
  }

  const sites = [
    { p: A_SITE, label: 'A' },
    { p: B_SITE, label: 'B' },
  ];
  for (const s of sites) {
    const sx = R + (s.p.x - px) * scale;
    const sy = R + (s.p.z - pz) * scale;
    const zoneR = PLANT_RADIUS * scale;
    if (sx + zoneR < 0 || sx - zoneR > W) continue;
    if (sy + zoneR < 0 || sy - zoneR > H) continue;
    c.strokeStyle = 'rgba(255,220,80,0.9)';
    c.lineWidth = 2;
    c.beginPath();
    c.arc(sx, sy, zoneR, 0, Math.PI * 2);
    c.stroke();
    c.fillStyle = 'rgba(255,220,80,0.15)';
    c.fill();
    c.fillStyle = 'rgba(255,255,255,0.95)';
    c.font = 'bold 20px sans-serif';
    c.textAlign = 'center';
    c.textBaseline = 'middle';
    c.fillText(s.label, sx, sy);
  }

  for (const op of otherPlayers.values()) {
    if (!op.visible) continue;
    const ox = op.group.position.x;
    const oz = op.group.position.z;
    const dx = ox - px, dz = oz - pz;
    if (Math.abs(dx) < MINIMAP_RANGE && Math.abs(dz) < MINIMAP_RANGE) {
      const sx = R + dx * scale;
      const sy = R + dz * scale;
      c.fillStyle = '#ff3333';
      c.beginPath(); c.arc(sx, sy, 5, 0, Math.PI * 2); c.fill();
      c.strokeStyle = 'rgba(0,0,0,0.7)'; c.lineWidth = 1.5; c.stroke();
    }
  }


  c.save();
  c.translate(R, R);
  c.rotate(-player.yaw);
  c.fillStyle = '#3fa9ff';
  c.beginPath();
  c.moveTo(0, -14); c.lineTo(-9, 10); c.lineTo(0, 5); c.lineTo(9, 10);
  c.closePath(); c.fill();
  c.strokeStyle = '#fff'; c.lineWidth = 2; c.stroke();
  c.restore();

  c.restore();

  c.strokeStyle = 'rgba(220,220,220,0.85)';
  c.lineWidth = 4;
  c.beginPath(); c.arc(R, R, R - 2, 0, Math.PI * 2); c.stroke();
  c.fillStyle = '#fff';
  c.font = 'bold 24px sans-serif';
  c.textAlign = 'center'; c.textBaseline = 'middle';
  c.fillText('N', R, 22);
}

/* ==================== [M] 主循环 ==================== */
let posSendAccum = 0;
let lastC4BeepSec = -1;
function loop() {
  requestAnimationFrame(loop);
  const dt = Math.min(clock.getDelta(), 0.05);

  if (state.playing) {
    state.shootCd = Math.max(0, state.shootCd - dt);
    if (state.reloading && state.reloadStartedAt) {
      state.reloadProgress = Math.min(1, (performance.now() - state.reloadStartedAt) / 1800);
    } else {
      state.reloadProgress = 0;
    }
    updatePlayer(dt);
    updateCamera();
    updateWeaponRecoilCF(dt);

    if ((mouse.held || touch.fire) && state.shootCd <= 0) {
      playerShoot();
    }

    updatePlayerVRM(dt);
    updateFirstPersonClip();
    updateOtherPlayers(dt);
    updateCorpses();
    updateLocalBullets(dt);
    updateImpacts(dt);
    updatePickups(dt);
    drawMinimap();
    drawMobileHud();

    const plantBtn = document.getElementById('plantBtn');
    if (plantBtn) {
      const dA = Math.hypot(player.pos.x - A_SITE.x, player.pos.z - A_SITE.z);
      const dB = Math.hypot(player.pos.x - B_SITE.x, player.pos.z - B_SITE.z);
      const inZone = Math.min(dA, dB) < PLANT_RADIUS + 2.5;
      const plantVisible = normalizeTouchConfig(touchLayouts?.[touchLayoutOrientation()]?.plantBtn)?.visible !== false;
      if (plantVisible && state.c4Held && !state.c4Planted && state.holding === 'c4' && inZone && state.alive) {
        plantBtn.classList.remove('hidden');
      } else {
        plantBtn.classList.add('hidden');
      }
    }

    const switchBtn = document.getElementById('switchBtn');
    if (switchBtn) {
      const switchVisible = normalizeTouchConfig(touchLayouts?.[touchLayoutOrientation()]?.switchBtn)?.visible !== false;
      if (switchVisible && state.c4Held && !state.c4Planted && state.alive && isTouch) {
        switchBtn.classList.remove('hidden');
      } else {
        switchBtn.classList.add('hidden');
      }
    }

    if (state.c4Planted) {
      const t = Math.max(0, Math.ceil(state.c4EndAt ? (state.c4EndAt - (Date.now() + serverClockOffset)) / 1000 : state.c4Fuse));
      const timerEl = document.getElementById('c4Timer');
      if (timerEl) {
        timerEl.classList.remove('hidden');
        timerEl.textContent = t;
        if (t <= 10) timerEl.classList.add('warning');
      }
      if (t !== lastC4BeepSec && t > 0) {
        lastC4BeepSec = t;
        if (t <= 10) {
          playBeep(1400, 0.09, 0.22);
        } else if (t <= 20) {
          playBeep(1100, 0.07, 0.16);
        } else {
          playBeep(900, 0.05, 0.10);
        }
      }
    } else {
      const timerEl = document.getElementById('c4Timer');
      if (timerEl) timerEl.classList.add('hidden');
      lastC4BeepSec = -1;
      state.c4EndAt = 0;
    }

    posSendAccum += dt;
    if (posSendAccum >= positionSendIntervalMs / 1000) {
      posSendAccum = 0;
      sendPos();
    }
  }

  if (playerVRM) playerVRM.update(dt);

  if (composer && !optimizeMode) {
    composer.render();
  } else {
    renderer.render(scene, camera);
  }
}

