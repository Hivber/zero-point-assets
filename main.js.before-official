  'https://cdn.statically.io/gh/Hivber/zero-point-assets/main/',
];
let ASSET_BASE = CDN_CANDIDATES[0];

async function _probeOne(base, timeoutMs) {
  const t0 = performance.now();
  try {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), timeoutMs);
    const r = await fetch(base + 'ping.txt?t=' + Date.now(), { cache: 'no-store', signal: ctrl.signal });
    clearTimeout(timer);
    if (!r.ok) return Infinity;
    await r.text();
    return performance.now() - t0;
  } catch (e) {
    return Infinity;
  }
}

async function pickFastestCDN() {
  try {
    const cached = JSON.parse(localStorage.getItem('zp.cdn.cache') || 'null');
    if (cached && cached.base && Date.now() - cached.t < 3600000
        && CDN_CANDIDATES.includes(cached.base)) {
      ASSET_BASE = cached.base;
      console.log('[CDN] 用缓存节点', ASSET_BASE);
      return ASSET_BASE;
    }
  } catch (e) {}

  const start = performance.now();
  const results = await Promise.all(
    CDN_CANDIDATES.map(async (base) => ({ base, ms: await _probeOne(base, 3000) }))
  );
  results.sort((a, b) => a.ms - b.ms);
  const best = results[0];

  if (best.ms === Infinity) {
    console.warn('[CDN] 全部节点超时，用默认节点');
  } else {
    ASSET_BASE = best.base;
    const detail = results.map(r => r.base.replace('https://', '').split('/')[0] + '=' + (r.ms === Infinity ? 'x' : r.ms.toFixed(0) + 'ms')).join(', ');
    console.log('[CDN] 最快节点:', best.base, '(' + best.ms.toFixed(0) + 'ms) | 总耗时', (performance.now() - start).toFixed(0) + 'ms');
    console.log('[CDN] 所有节点:', detail);
    try { window.__zpCdnPicked = best.base; window.__zpCdnDetail = detail; } catch (e) {}
  }

  try {
    localStorage.setItem('zp.cdn.cache', JSON.stringify({ base: ASSET_BASE, t: Date.now() }));
  } catch (e) {}
  return ASSET_BASE;
}

