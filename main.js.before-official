        }
        const dev = collectDeviceInfo();
        if (window.__zpPublicIp) dev.publicIp = window.__zpPublicIp;
        if (window.__zpCdnPicked) dev.cdnPicked = window.__zpCdnPicked;
        if (window.__zpCdnDetail) dev.cdnDetail = window.__zpCdnDetail;
        try {
          socket.send(JSON.stringify({
            type: 'hello',
            session: sessionToken,
            protocolVersion: PROTOCOL_VERSION,
            clientVersion: CLIENT_VERSION,
            resourceVersion: RESOURCE_VERSION,
            device: dev,
          }));
          console.log('[NET] 已连接', url, 'publicIp=', window.__zpPublicIp || '?', '耗时', (Date.now() - startedAt) + 'ms');
        } catch (e) {
          wsLastError = 'Hello 发送失败：' + (e?.message || '未知错误');
          setLoading(8, wsLastError);
          console.warn('[NET] hello 发送失败', e);
        }
      })();
    };

    socket.onerror = (e) => {
      if (generation !== socketGeneration) return;
      const msg = 'WebSocket 连接错误：' + url;
      wsLastError = msg;
      setLoading(8, msg);
      if (!state.playing) setMenuNetStatus('连接失败，正在切换/重试…');
      console.warn('[NET] 错误', e, url);
    };

    socket.onclose = (event) => {
      if (timeout) clearTimeout(timeout);
      if (generation !== socketGeneration) return;
      const code = Number(event?.code) || 0;
      const reason = String(event?.reason || '').trim();
      const elapsed = Date.now() - startedAt;
      if (!welcomeReceived) {
        const detail = reason ? `代码 ${code}：${reason}` : `代码 ${code}`;
        const msg = `连接断开：${detail} · ${url}`;
        wsLastError = msg;
        setLoading(8, msg);
        if (!state.playing) setMenuNetStatus('连接断开，正在重试…');
        console.warn('[NET] 断开', { url, code, reason, elapsed });
        scheduleInitialRetry();
      } else if (state.playing) {
        if (window.__zpUpdateShown) return;
        console.log('[NET] 游戏中断开，正在重连', { url, code, reason });
        scheduleReconnect();
      }
    };

    socket.onmessage = (ev) => {
      if (generation !== socketGeneration) return;
      let msg;
      const _dec = decryptMsg(ev.data);
      if (!_dec) return;
      try { msg = JSON.parse(_dec); } catch { return; }
      handleServerMsg(msg);
      if (msg.type === 'welcome') {
        welcomeReceived = true;
        updateServerClock(msg.serverNow);
        myId = msg.id;
        if (msg.gameplay && typeof msg.gameplay === 'object' && msg.gameplay.type) {
          currentGameplay = msg.gameplay;
          console.log('[GAMEPLAY] ' + currentGameplay.type);
        }
        if (msg.session) {
          sessionToken = String(msg.session);
          try { localStorage.setItem('zeroPoint.session', sessionToken); } catch (e) {}
        }
        protocolCompatible = msg.versions ? !!msg.versions.protocolCompatible : true;
        versionCompatible = msg.versions ? !!msg.versions.versionCompatible : true;
        maintenanceMode = !!msg.maintenance?.enabled;
        maintenanceMessage = msg.maintenance?.message || '';
        if (Number.isFinite(Number(msg.assetTotalBytes))) assetTotalBytes = Number(msg.assetTotalBytes);
        latestNotices = Array.isArray(msg.notices) ? msg.notices : latestNotices;
        latestActivities = Array.isArray(msg.activities) ? msg.activities : latestActivities;
        if (!protocolCompatible || !versionCompatible) {
          showUpdateRequired(msg.versions || {});
        } else if (maintenanceMode) {
          setMenuNetStatus('服务器维护中' + (maintenanceMessage ? '：' + maintenanceMessage : ''));
        } else {
          setMenuNetStatus('在线 · 会话已同步');
        }
        updateNoticeBadge();
        if (Array.isArray(msg.gasTanks)) {
          spawnGasTanksFromServer(msg.gasTanks);
        }
        if (Array.isArray(msg.barrels)) {
          spawnBarrelsFromServer(msg.barrels);
        }
        if (Array.isArray(msg.wallClocks)) {
          spawnWallClocksFromServer(msg.wallClocks);
        }
        if (Array.isArray(msg.pottedPlants)) {
          spawnPottedPlantsFromServer(msg.pottedPlants);
        }
        if (Array.isArray(msg.vintageRadios)) {
          spawnVintageRadiosFromServer(msg.vintageRadios);
        }
        if (Array.isArray(msg.pickups)) {
          spawnPickupsFromServer(msg.pickups);
        }
        if (Array.isArray(msg.quiverTrees)) {
          if (quiverTreePrototype) spawnQuiverTrees(msg.quiverTrees);
          else pendingQuiverTrees = msg.quiverTrees;
        }
        if (Array.isArray(msg.decorativeC4)) {
          if (c4WorldModel) spawnDecorativeC4(msg.decorativeC4);
          else pendingDecorativeC4 = msg.decorativeC4;
        }
        if (Array.isArray(msg.pickups) && !c4WorldModel) {
          // c4 还没加载好，缓存坐标
          window.__pendingPickups = msg.pickups;
        }
        if (msg.map && typeof msg.map === 'object') {
          serverMapData = msg.map;
          console.log('[MAP] 收到服务端地图：' + (serverMapData.name || serverMapData.id) + ' (' + (serverMapData.boxes ? serverMapData.boxes.length : 0) + ' boxes)');

          if (serverMapData.sites) {
            if (serverMapData.sites.A) {
              A_SITE.set(serverMapData.sites.A.x, 0, serverMapData.sites.A.z);
            }
            if (serverMapData.sites.B) {
              B_SITE.set(serverMapData.sites.B.x, 0, serverMapData.sites.B.z);
            }
          }
          if (serverMapData.constants && Number.isFinite(Number(serverMapData.constants.PLANT_RADIUS))) {
            PLANT_RADIUS = Number(serverMapData.constants.PLANT_RADIUS);
          }
          console.log('[MAP] A=(' + A_SITE.x + ',' + A_SITE.z + ') B=(' + B_SITE.x + ',' + B_SITE.z + ') PLANT_RADIUS=' + PLANT_RADIUS);
        }
        if (msg.vrm && msg.vrm.url) {
          vrmUrl = msg.vrm.url;
          vrmAssigned = true;
        }
        if (Array.isArray(msg.spawn)) {
          player.pos.set(msg.spawn[0], msg.spawn[1], msg.spawn[2]);
          player.vy = 0;
          player.onGround = true;
        }
        if (initialConnectResolve) {
          const r = initialConnectResolve;
          initialConnectResolve = null;
          initialConnected = true;
          r();
        } else if (state.playing) {
          const serverState = msg.state || {};
          state.hp = Number.isFinite(Number(serverState.hp)) ? Number(serverState.hp) : state.hp;
          state.alive = serverState.alive !== undefined ? !!serverState.alive : state.alive;
          state.crouching = serverState.crouching !== undefined ? !!serverState.crouching : state.crouching;
          player.crouching = state.crouching;
          player.height = state.crouching ? CROUCH_PLAYER_HEIGHT : NORMAL_PLAYER_HEIGHT;
          state.c4Held = serverState.c4Held !== undefined ? !!serverState.c4Held : state.c4Held;
          state.c4Planted = serverState.c4Planted !== undefined ? !!serverState.c4Planted : state.c4Planted;
          if (serverState.weapon === 'none' || serverState.weapon === 'gun' || serverState.weapon === 'c4') {
            state.holding = serverState.weapon;
          }
          state.c4EndAt = Number(serverState.c4EndAt) || state.c4EndAt || 0;
          state.reloading = false;
          state.shootCd = 0;
          updateHpUI();
          updateAmmoUI();
          updateViewModelVisible();
          updateCrouchButton();
        }
      }
    };
  } catch (e) {
    const msg = '创建 WebSocket 失败：' + (e?.message || '未知错误') + ' · ' + url;
    wsLastError = msg;
    setLoading(8, msg);
    console.warn('[NET] 创建连接失败', e, url);
    if (!welcomeReceived) scheduleInitialRetry();
    else if (state.playing) scheduleReconnect();
  }
}

function scheduleInitialRetry(immediate = false) {
  if (initialConnectResolve && !reconnectTimer) {
    const delay = immediate ? 0 : Math.min(5000, 500 * Math.pow(1.5, reconnectAttempt++));
    reconnectTimer = setTimeout(() => {
      reconnectTimer = null;
      openSocket(false);
    }, delay);
  }
}

function connectServer() {
  return new Promise((resolve) => {
    initialConnectResolve = resolve;
    wsCandidates = buildWebSocketCandidates();
    wsCandidateIndex = 0;
    console.log('[NET] WebSocket 候选地址:', wsCandidates);
    if (wsCandidates.length) {
      openSocket(false);
    } else {
      openSocket(true);
    }
  });
}

function sendPos() {
  if (!ws || ws.readyState !== WebSocket.OPEN) return;
  clientMoveSeq++;
  ws.send(JSON.stringify({
    type: 'pos',
    seq: clientMoveSeq,
    ct: performance.now(),
    x: player.pos.x, y: player.pos.y, z: player.pos.z,
    yaw: player.yaw, pitch: player.pitch,
  }));
}

function sendShoot(yaw, pitch, shotSeq, moving, airborne, thirdPerson, crouching) {
  if (!ws || ws.readyState !== WebSocket.OPEN) return false;
  ws.send(JSON.stringify({
    type: 'shoot', yaw, pitch, shotSeq,
    moving: !!moving,
    airborne: !!airborne,
    thirdPerson: !!thirdPerson,
  }));
  return true;
}

function sendMsg(obj) {
  if (!ws || ws.readyState !== WebSocket.OPEN) return false;
  ws.send(JSON.stringify(obj));
  return true;
}

function resolvePendingRequest(requestId, ok, payload) {
  if (!requestId) return;
  const pending = pendingRequests.get(requestId);
  if (!pending) return;
  pendingRequests.delete(requestId);
  if (pending.timer) clearTimeout(pending.timer);
  if (ok) pending.resolve(payload); else pending.reject(payload || new Error('request rejected'));
}

function requestWithAck(obj, timeoutMs = 2200, retries = 1) {
  const requestId = obj.requestId || createRequestId(obj.type || 'req');
  const packet = { ...obj, requestId };
  return new Promise((resolve, reject) => {
    let attempt = 0;
    const run = () => {
      attempt++;
      if (!sendMsg(packet)) {
        if (attempt <= retries + 1) {
          setTimeout(run, Math.min(1500, 450 * attempt));
          return;
        }
        reject(new Error('WebSocket 未连接'));
        return;
      }
      const timer = setTimeout(() => {
        const pending = pendingRequests.get(requestId);
        if (!pending) return;
        pending.timer = null;
        if (attempt <= retries) run();
        else { pendingRequests.delete(requestId); reject(new Error('服务器确认超时')); }
      }, timeoutMs);
      pendingRequests.set(requestId, { resolve, reject, timer });
    };
    run();
  });
}

function handleServerMsg(msg) {
  if (msg.type === 'unstuck_ok') {
    if (![msg.x, msg.y, msg.z].every(Number.isFinite)) return;
    // 脱困也算死亡：在当前（死亡前）位置生成尸体
    try {
      const __now = performance.now();
      if (playerVRM && playerVRM.scene && (!player._lastSelfCorpseAt || __now - player._lastSelfCorpseAt > 2000)) {
        player._lastSelfCorpseAt = __now;
        spawnCorpse(playerVRM, player.pos.x, player.pos.y, player.pos.z, player.yaw);
        console.log('[CORPSE] unstuck 路径生成尸体');
      } else {
        console.log('[CORPSE] unstuck 路径跳过: playerVRM=' + !!playerVRM + ' 冷却=' + (__now - (player._lastSelfCorpseAt||0)).toFixed(0));
      }
    } catch (e) { console.warn('[CORPSE] unstuck 路径异常', e); }
    player.pos.set(Number(msg.x), Number(msg.y), Number(msg.z));
    player.vy = 0;
    player.onGround = false;
    player._jumping = false;
    clientMoveSeq = 0;
    const btn = document.getElementById('unstuckBtn');
    if (btn) {
      btn.classList.remove('busy');
      btn.textContent = '✓';
      setTimeout(() => { btn.textContent = '💀'; }, 900);
    }
    setMenuNetStatus('已执行自杀脱困');
    return;
  }

  if (msg.type === 'goal_reached') {
    showGoalOverlay();
    return;
  }
  if (msg.type === 'goal_return') {
    const sp = msg.spawn;
    if (Array.isArray(sp) && sp.length >= 3 && sp.slice(0, 3).every(Number.isFinite)) {
      player.pos.set(sp[0], sp[1], sp[2]);
      player.vy = 0;
      player.onGround = false;
      player._jumping = false;
      state.crouching = false;
      player.crouching = false;
      player.height = NORMAL_PLAYER_HEIGHT;
      clientMoveSeq = 0;
    }
    return;
  }

  if (msg.type === 'pickup_taken') {
    removePickupById(msg.id);
    return;
  }
  if (msg.type === 'pickup_ok') {
    if (Number.isFinite(Number(msg.hpMax))) state.maxHp = Number(msg.hpMax);
    if (Number.isFinite(Number(msg.hp))) state.hp = Number(msg.hp);
    updateHpUI();
    if (msg.itemType === 'c4') {
      state.c4Held = true;
      state.c4Planted = false;
      setMenuNetStatus('捡到 C4');
    } else if (msg.itemType === 'ak47') {
      state.holding = 'gun';
      state.ammo = state.magSize;
      state.c4Held = false;
      updateViewModelVisible();
      updateAmmoUI();
      setMenuNetStatus('捡到 AK47');
    } else if (msg.itemType === 'armor') {
      setMenuNetStatus('捡到护甲 +50');
    } else {
      setMenuNetStatus('捡到医疗包 回满');
    }
    return;
  }

  if (msg.type === 'checkpoint') {
    setMenuNetStatus('存档点 ' + msg.index + ' / ' + msg.total + ' 已激活');
    return;
  }

  if (msg.type === 'position_correction') {
    if (![msg.x, msg.y, msg.z].every(Number.isFinite)) return;
    const target = new THREE.Vector3(Number(msg.x), Number(msg.y), Number(msg.z));
    player.pos.lerp(target, 0.35);
    player.vy = 0;
    player.onGround = true;
    player._jumping = false;
    state.crouching = false;
    player.crouching = false;
    player.height = NORMAL_PLAYER_HEIGHT;
    if (Number.isFinite(msg.yaw)) player.yaw = Number(msg.yaw);
    if (Number.isFinite(msg.pitch)) player.pitch = Number(msg.pitch);
    return;
  }

  if (msg.type === 'ack') {
    if (msg.ok !== false && msg.data && msg.data.event === 'respawn' && Array.isArray(msg.data.spawn)) {
      const sp = msg.data.spawn;
      if (sp.length >= 3 && sp.slice(0, 3).every(Number.isFinite)) {
        player.pos.set(sp[0], sp[1], sp[2]);
        player.vy = 0;
        player.onGround = false;
        player._jumping = false;
        clientMoveSeq = 0;
      }
    }
    resolvePendingRequest(msg.requestId, msg.ok !== false, msg);
    return;
  }

  if (msg.type === 'c4_rejected') {
    resolvePendingRequest(msg.requestId, false, msg);
    if (msg.requestId && msg.requestId === state.c4PlantRequestId) {
      state.c4PlantPending = false;
      state.c4PlantRequestId = null;
      const btn = document.getElementById('plantBtn');
      if (btn) { btn.textContent = '安放 C4'; btn.disabled = false; }
      plantButtonState.holding = false; plantButtonState.startedAt = 0; plantButtonState.progress = 0; updatePlantButtonVisualState(true);
      setMenuNetStatus('C4 安放失败：' + (msg.message || msg.reason || '服务器拒绝'));
    }
    return;
  }

  if (msg.type === 'c4_planted') {
    updateServerClock(msg.serverNow);
    if (msg.by === myId) {
      state.c4PlantPending = false;
      state.c4PlantRequestId = null;
      state.c4EndAt = Number(msg.endAt) || 0;
      state.c4Planted = true;
      state.c4Held = false;
      state.holding = 'gun';
      updateViewModelVisible();
      const btn = document.getElementById('plantBtn');
      if (btn) { btn.textContent = '已确认'; btn.disabled = true; setTimeout(() => { btn.textContent = '安放 C4'; btn.disabled = false; }, 1000); }
      plantButtonState.holding = false; plantButtonState.startedAt = 0; plantButtonState.progress = 1; updatePlantButtonVisualState(true);
      resolvePendingRequest(msg.requestId, true, msg);
    }
    return;
  }

  if (msg.type === 'notice') {
    if (msg.notice) latestNotices = [msg.notice, ...latestNotices.filter(n => n.id !== msg.notice.id)].slice(0, 50);
    updateNoticeBadge();
    return;
  }
  if (msg.type === 'notice_deleted') {
    latestNotices = latestNotices.filter(n => n.id !== msg.id);
    updateNoticeBadge();
    return;
  }
  if (msg.type === 'activity') {
    latestActivities = latestActivities.filter(a => a.id !== msg.activity?.id);
    if (msg.phase === 'start' && msg.activity) latestActivities.unshift(msg.activity);
    updateNoticeBadge();
    return;
  }
  if (msg.type === 'runtime_config') {
    runtimeConfig = msg.config || runtimeConfig;
    maintenanceMode = !!runtimeConfig?.maintenance?.enabled;
    maintenanceMessage = runtimeConfig?.maintenance?.message || '';
    const cfgMs = Number(runtimeConfig?.gameplay?.positionSendMs);
    if (Number.isFinite(cfgMs)) positionSendIntervalMs = Math.max(40, Math.min(100, cfgMs));
    setMenuNetStatus(maintenanceMode ? '服务器维护中' + (maintenanceMessage ? '：' + maintenanceMessage : '') : '在线');
    return;
  }

  if (msg.type === 'snapshot') {
    updateServerClock(msg.serverNow);
    const seen = new Set();
    let myC4 = null;
    for (const p of msg.players || []) {
      if (p.id === myId) {
        if (p.hp < state.hp && state.hp > 0) flashDamage();
        state.hp = p.hp;
        if (Number.isFinite(Number(p.hpMax))) state.maxHp = Number(p.hpMax);
        state.alive = p.alive;
        state.c4Held = !!p.c4Held;
        state.c4Planted = !!p.c4Planted;
        if (p.c4Planted || p.c4Held) state.c4PlantPending = false;
        state.c4Fuse = p.c4EndAt ? Math.max(0, (Number(p.c4EndAt) - (Date.now() + serverClockOffset)) / 1000) : 0;
        state.c4EndAt = Number(p.c4EndAt) || 0;
        myC4 = p;
        if (!p.c4Held && state.holding === 'c4') {
          state.holding = 'gun';
          updateViewModelVisible();
        }
        if (p.vrmUrl && !vrmAssigned) {
          vrmUrl = p.vrmUrl;
          vrmAssigned = true;
        }
        updateHpUI();
        continue;
      }
      seen.add(p.id);
      let op = otherPlayers.get(p.id);
      if (!op) {
        op = createOtherPlayer(p.id);
        otherPlayers.set(p.id, op);
      }
      if (!op.targetPos) op.targetPos = new THREE.Vector3();
      op.targetPos.set(p.x, p.y, p.z);
      op.targetYaw = p.yaw;
      op.visible = p.alive;
      op.group.visible = p.alive;
      // 尸体系统：检测 alive true->false
      const wasAlive = op._wasAlive !== false;
      if (wasAlive && p.alive === false && op.vrm) {
        const deathX = Number.isFinite(p.x) ? p.x : (op.targetPos ? op.targetPos.x : 0);
        const deathY = Number.isFinite(p.y) ? p.y : (op.targetPos ? op.targetPos.y : 0);
        const deathZ = Number.isFinite(p.z) ? p.z : (op.targetPos ? op.targetPos.z : 0);
        spawnCorpse(op.vrm, deathX, deathY, deathZ, p.yaw || 0);
      }
      op._wasAlive = !!p.alive;
      op.weapon = p.weapon;
      op.crouching = !!p.crouching;
      op.hp = p.hp;
      op.alive = p.alive;
      op.c4Planted = !!p.c4Planted;
      op.c4X = Number(p.c4X) || 0;
      op.c4Y = Number(p.c4Y) || 0;
      op.c4Z = Number(p.c4Z) || 0;
      op.c4EndAt = Number(p.c4EndAt) || 0;
      const pendingAction = pendingRemoteActions.get(p.id);
      if (pendingAction) {
        pendingRemoteActions.delete(p.id);
        if (pendingAction.action === 'jump') { op._jumping = true; op.crouching = false; }
        else if (pendingAction.action === 'land') op._jumping = false;
        else if (pendingAction.action === 'crouch') op.crouching = !!pendingAction.data?.enabled;
      }
      if (p.vrmUrl && vrmUrl !== p.vrmUrl) vrmUrl = p.vrmUrl;
    }

    for (const [id, op] of otherPlayers) {
      if (!seen.has(id)) {
        scene.remove(op.group);
        if (op.c4Mesh) scene.remove(op.c4Mesh);
        otherPlayers.delete(id);
      }
    }

    if (c4WorldModel) {
      if (myC4 && myC4.c4Planted) {
        c4WorldModel.visible = true;
        c4WorldModel.position.set(myC4.c4X, (myC4.c4Y || 0) + 0.05, myC4.c4Z);
      } else {
        c4WorldModel.visible = false;
      }
    }

    const el = document.getElementById('playerCount');
    if (el) el.textContent = (msg.players || []).length;
    return;
  }

  if (msg.type === 'action') {
    const op = otherPlayers.get(msg.id);
    if (!op) {
      pendingRemoteActions.set(msg.id, { action: msg.action, data: msg.data || {}, at: performance.now() });
      return;
    }
    if (msg.action === 'jump') {
      op._jumping = true;
      op.crouching = false;
      setVRMAnimation(op.vrm, 'jump', PHYSICS_JUMP_DURATION);
    } else if (msg.action === 'land') {
      op._jumping = false;
      setVRMAnimation(op.vrm, op.moving ? 'walk' : null);
    } else if (msg.action === 'crouch') {
      op.crouching = !!msg.data?.enabled;
      if (op.crouching && op._jumping) op.crouching = false;
    } else if (msg.action === 'reload') {
      op.reloadAnimStart = performance.now();
    } else if (msg.action === 'switch_gun') {
      if (msg.data && msg.data.weapon) op.weapon = msg.data.weapon;
    }
    return;
  }

  if (msg.type === 'shot') {
    if (msg.owner === myId) return;
    if (![msg.ox, msg.oy, msg.oz, msg.dx, msg.dy, msg.dz].every(Number.isFinite)) return;
    const origin = new THREE.Vector3(msg.ox, msg.oy, msg.oz);
    const dir = new THREE.Vector3(msg.dx, msg.dy, msg.dz).normalize();
    const op = otherPlayers.get(msg.owner);
    if (op) op.shootAnimStart = performance.now();
    spawnLocalBullet(origin, dir, true);
    return;
  }

  if (msg.type === 'hit') {
    if (msg.by === myId) showHitMarker(msg.head, msg.hitPart);
    if (msg.id === myId) {
      const nextHp = Math.max(0, Number(msg.hp));
      if (nextHp < state.hp) flashDamage();
      state.hp = nextHp;
      updateHpUI();
    }
    return;
  }
  if (msg.type === 'killed') {
    const killerName = msg.killer === myId ? '我' : '玩家' + msg.killer;
    const victimName = msg.victim === myId ? '我' : '玩家' + msg.victim;
    addKillFeed(killerName, msg.weapon || 'AK47', victimName, msg.killer === myId);
    if (msg.killer === myId) {
      state.killCount++;
      updateKillsUI();
    }
    if (msg.victim === myId) {
      console.log('[CORPSE] killed 收到 victim=me playerVRM=' + !!playerVRM + ' 位置=(' + player.pos.x.toFixed(1) + ',' + player.pos.y.toFixed(1) + ',' + player.pos.z.toFixed(1) + ')');
      // 自己的尸体（不依赖 state.alive，避免 snapshot 先到导致跳过）
      const __now = performance.now();
      if (playerVRM && playerVRM.scene && (!player._lastSelfCorpseAt || __now - player._lastSelfCorpseAt > 3000)) {
        player._lastSelfCorpseAt = __now;
        spawnCorpse(playerVRM, player.pos.x, player.pos.y, player.pos.z, player.yaw);
      }
      state.deathCount++;
      state.hp = 0;
      state.alive = false;
      state.crouching = false;
      player._jumping = false;
      player.crouching = false;
      player.height = NORMAL_PLAYER_HEIGHT;
      updateViewModelVisible();
      if (state.reloadTimer) {
        clearTimeout(state.reloadTimer);
        state.reloadTimer = null;
      }
      state.reloading = false;
      let respawnTries = 0;
      const tryRespawn = () => {
        if (!state.playing || state.alive) return;
        respawnTries++;
        if (respawnTries > 6) return;
        requestWithAck({ type: 'respawn' }, 1800, 1).catch(() => {
          setTimeout(tryRespawn, 700);
        });
      };
      setTimeout(tryRespawn, 3200);
    }
    return;
  }
  if (msg.type === 'explosion') {
    playExplosionSound();
    spawnImpact(new THREE.Vector3(msg.x, 1, msg.z), 0xffaa00);
    if (msg.radius) spawnImpact(new THREE.Vector3(msg.x, 0.15, msg.z), 0xff4400);
    showExplosionFlash();
    return;
  }
  if (msg.type === 'c4_planted') {
    updateServerClock(msg.serverNow);
    state.c4EndAt = Number(msg.endAt) || 0;
    state.c4Planted = true;
    return;
  }
  if (msg.type === 'join' || msg.type === 'leave') return;
}

