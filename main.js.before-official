const PICKUP_COLORS = {
  armor: 0x3fa9ff,
  medkit: 0x4ddb82,
};

function placePickupModel(srcModel, item, bigScale, rotArr) {
  const grp = new THREE.Group();
  grp.position.set(item.x, 0, item.z);
  scene.add(grp);

  const mesh = srcModel.clone(true);
  mesh.visible = true;
  mesh.scale.multiplyScalar(bigScale);
  mesh.position.set(0, 0, 0);
  mesh.rotation.set(rotArr[0], rotArr[1], rotArr[2]);

  grp.add(mesh);
  grp.updateMatrixWorld(true);

  const worldBox = new THREE.Box3().setFromObject(grp);
  grp.position.y = 0.15 - worldBox.min.y;
  grp.updateMatrixWorld(true);
  return grp;
}

function spawnPickupAt(item) {
  let src = null, bigScale = 1;
  if (item.type === 'ak47') { src = gunModel; bigScale = 3.0; }
  else if (item.type === 'c4') { src = c4WorldModel; bigScale = 2.5; }
  if (!src) return;

  // 从 gameplay.pickupRotations 读旋转，没有就用默认 [0,0,0]
  const rots = (currentGameplay.pickupRotations) || {};
  const rotArr = rots[item.type] || [0, 0, 0];

  const grp = placePickupModel(src, item, bigScale, rotArr);
  grp.userData.itemId = item.id;
  grp.userData.itemType = item.type;
  pickups.push({ mesh: grp, id: item.id, type: item.type, x: item.x, z: item.z });
}







function spawnPickupsFromServer(list) {
  for (const p of pickups) {
    if (p.mesh && p.mesh.parent) p.mesh.parent.remove(p.mesh);
    if (p.mesh) scene.remove(p.mesh);
  }
  pickups.length = 0;
  if (!Array.isArray(list) || !list.length) return;
  if (!gunModel || !c4WorldModel) {
    window.__pendingPickups = list.slice();
    console.log('[PICKUP] 模型未就绪，缓存 ' + list.length + ' 个');
    return;
  }
  for (const item of list) {
    if (Number.isFinite(Number(item.x)) && Number.isFinite(Number(item.z))) {
      spawnPickupAt(item);
    }
  }
  console.log('[PICKUP] 渲染了 ' + pickups.length + ' 个');
}

function removePickupById(id) {
  for (let i = pickups.length - 1; i >= 0; i--) {
    if (pickups[i].id === id) {
      const p = pickups[i];
      if (p.mesh && p.mesh.parent) p.mesh.parent.remove(p.mesh);
      if (p.mesh) scene.remove(p.mesh);
      pickups.splice(i, 1);
      return;
    }
  }
}

function updatePickups(dt) {
  if (!state.playing || !state.alive) return;
  let closest = null, closestDist = 3.2;
  for (const p of pickups) {
    const d = Math.hypot(player.pos.x - p.x, player.pos.z - p.z);
    if (d < closestDist) { closestDist = d; closest = p; }
  }
  if (closest) {
    if (closest.id !== updatePickups._lastSent || (performance.now() - (updatePickups._lastSentAt || 0)) > 500) {
      updatePickups._lastSent = closest.id;
      updatePickups._lastSentAt = performance.now();
      sendMsg({ type: 'pickup', id: closest.id });
    }
  }
}

