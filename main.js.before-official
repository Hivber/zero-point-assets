  if (code === 'Escape') { rebindingAction = null; updateKeybindUI(); return; }
  if (['Unidentified', 'MetaLeft', 'MetaRight'].includes(code)) return;
  const action = rebindingAction;
  const conflict = Object.keys(keybinds).find((a) => a !== action && keybinds[a] === code);
  // 一个按键只绑定一个动作：若发生冲突，则交换两个动作的键位。
