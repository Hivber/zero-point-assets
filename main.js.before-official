let audioCtx = null;
const soundBuffers = { fire: null, reload: null, explosion: null };

function initAudio() {
  try {
    if (!audioCtx) {
      const Ctx = window.AudioContext || window.webkitAudioContext;
      if (Ctx) audioCtx = new Ctx();
    }
  } catch (e) {}
}
function ensureAudio() {
  if (!audioCtx) initAudio();
  if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
}
async function loadSounds() {
  if (!audioCtx) initAudio();
  if (!audioCtx) return;
  const load = (url) => fetch(url).then(r => r.arrayBuffer())
    .then(d => audioCtx.decodeAudioData(d)).catch(() => null);
  const [f, r, e] = await Promise.all([
    load(ASSET_BASE + 'sounds/rifle_fire.wav'),
    load(ASSET_BASE + 'sounds/reload.wav'),
    load(ASSET_BASE + 'sounds/explosion.mp3'),
  ]);
  soundBuffers.fire = f; soundBuffers.reload = r; soundBuffers.explosion = e;
  console.log('[SOUND]', f ? 'fire OK' : 'fire x', r ? 'reload OK' : 'reload x', e ? 'boom OK' : 'boom x');
}
function playSound(name, vol = 1) {
  const b = soundBuffers[name];
  if (!b || !audioCtx || audioCtx.state !== 'running') return;
  try {
    const s = audioCtx.createBufferSource();
    s.buffer = b;
    const g = audioCtx.createGain();
    g.gain.value = vol;
    s.connect(g); g.connect(audioCtx.destination);
    s.start(0);
  } catch (e) {}
}
function playGunSound() { playSound('fire', 0.5); }
function playReloadSound() { playSound('reload', 0.6); }
function playExplosionSound() { playSound('explosion', 0.9); }
function playBeep(f = 880, d = 0.15, v = 0.15) {
  if (!audioCtx || audioCtx.state !== 'running') return;
  const t = audioCtx.currentTime;
  const o = audioCtx.createOscillator(), g = audioCtx.createGain();
  o.frequency.value = f; o.type = 'square';
  g.gain.setValueAtTime(v, t);
  g.gain.exponentialRampToValueAtTime(0.001, t + d);
  o.connect(g); g.connect(audioCtx.destination);
  o.start(t); o.stop(t + d);
}

