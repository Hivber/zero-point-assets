  return vrmUrl;
}
async function _fetchVRMBuffer(url, attempts = 3, timeoutMs = 20000) {
  const absUrl = new URL(url, location.href).href;
  let lastError = null;
  for (let i = 1; i <= attempts; i++) {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), timeoutMs);
    try {
      const retryUrl = i === 1 ? absUrl : absUrl + (absUrl.includes('?') ? '&' : '?') + 'zpvrmretry=' + i + '_' + Date.now();
      const res = await fetch(retryUrl, { cache: 'no-store', signal: ctrl.signal });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const buf = await res.arrayBuffer();
      if (!buf || buf.byteLength < 1024) throw new Error('VRM 文件内容异常（' + (buf?.byteLength || 0) + ' bytes）');
      return { absUrl, buf };
    } catch (e) {
      lastError = e;
      console.warn('[VRM] 下载失败，第 ' + i + '/' + attempts + ' 次:', e?.message || e);
    } finally {
      clearTimeout(timer);
    }
  }
  throw new Error('玩家模型下载失败：' + (lastError?.message || '未知错误'));
}

async function loadVRMInstance(url) {
  const { absUrl, buf } = await _fetchVRMBuffer(url, 3, 20000);
  try { setLoading(75, '解析玩家模型…'); } catch (e) {}
  const loader = new GLTFLoader();
  loader.register((p) => new VRMLoaderPlugin(p));
  const resourcePath = new URL('./', absUrl).href;
  const gltf = await withTimeout(new Promise((res, rej) =>
    loader.parse(buf, resourcePath, res, rej)
  ), 30000, '玩家模型解析超时');
  const vrm = gltf.userData.vrm;
  if (!vrm || !vrm.scene) throw new Error('VRM 解析成功但未找到 VRM 场景');
  try {
    VRMUtils.removeUnnecessaryVertices(vrm.scene);
    VRMUtils.combineSkeletons(vrm.scene);
  } catch (e) {}
  vrm.scene.traverse(o => {
    if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; o.frustumCulled = false; }
  });
  return vrm;
}

/* ==================== [D] 地图 ==================== */
function addBox(mat, x, y, z, w, h, d, collide = true) {
  const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
  mesh.position.set(x, y, z);
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  scene.add(mesh);
  if (collide) {
    colliders.push({
      min: new THREE.Vector3(x - w/2, y - h/2, z - d/2),
      max: new THREE.Vector3(x + w/2, y + h/2, z + d/2),
    });
    minimapWalls.push({ x, z, w, d });
  }
  return mesh;
}

function buildMap(tex) {
  if (!serverMapData || !Array.isArray(serverMapData.boxes)) {
    console.warn('[MAP] 服务端未下发地图，只有空地面');
    const ground = new THREE.Mesh(new THREE.PlaneGeometry(200, 200), tex.groundMat);
    ground.rotation.x = -Math.PI / 2;
    ground.receiveShadow = true;
    scene.add(ground);
    scene.add(new THREE.HemisphereLight(0xf5e0b0, 0x605040, 0.85));
    const sun = new THREE.DirectionalLight(0xfff0d0, 1.8);
    sun.position.set(50, 90, 30);
    sun.castShadow = true;
    sun.shadow.mapSize.set(1024, 1024);
    sun.shadow.camera.far = 250;
    scene.add(sun);
    return;
  }
  buildFromServerMap(serverMapData, tex);
}

function buildFromServerMap(mapData, tex) {
  const gs = (mapData.world && mapData.world.ground_size) || 200;
  const groundTexture = (mapData.groundMat === 'grass' && tex.grassMat) ? tex.grassMat : tex.groundMat;
  const ground = new THREE.Mesh(new THREE.PlaneGeometry(gs, gs), groundTexture);
  ground.rotation.x = -Math.PI / 2;
  ground.receiveShadow = true;
  scene.add(ground);

  scene.add(new THREE.HemisphereLight(0xf5e0b0, 0x605040, 0.85));
  const sun = new THREE.DirectionalLight(0xfff0d0, 1.8);
  sun.position.set(50, 90, 30);
  sun.castShadow = true;
  sun.shadow.mapSize.set(1024, 1024);
  sun.shadow.camera.left = -70; sun.shadow.camera.right = 70;
  sun.shadow.camera.top = 70;   sun.shadow.camera.bottom = -70;
  sun.shadow.camera.far = 250;
  scene.add(sun);

  const crateMat = new THREE.MeshStandardMaterial({ color: 0xb88a50, roughness: 0.85, metalness: 0.05 });
  const stoneMat = new THREE.MeshStandardMaterial({ color: 0xc4ad88, roughness: 0.95, metalness: 0.05 });
  const matMap = { wall: tex.wallMat, crate: crateMat, stone: stoneMat };

  for (const b of mapData.boxes) {
    const mat = matMap[b.mat] || tex.wallMat;
    addBox(mat, b.x, b.y, b.z, b.w, b.h, b.d);
  }

  addSiteMarker(A_SITE, 0xffcc33);
  addSiteMarker(B_SITE, 0xffcc33);

  console.log('[MAP] 按服务端数据构建了 ' + mapData.boxes.length + ' 个盒子');
}

function addSiteMarker(pos, color) {
  const ringGeo = new THREE.RingGeometry(PLANT_RADIUS - 0.3, PLANT_RADIUS, 48);
  const ringMat = new THREE.MeshBasicMaterial({
    color, side: THREE.DoubleSide, transparent: true, opacity: 0.85,
    depthWrite: false,
  });
  const ring = new THREE.Mesh(ringGeo, ringMat);
  ring.rotation.x = -Math.PI / 2;
  ring.position.set(pos.x, 0.15, pos.z);
  scene.add(ring);
}


/* ==================== [E] 玩家移动 ==================== */
function aabbHit(x, y, z, r, h) {
  const top = y + h;
  for (const c of colliders) {
    if (x + r > c.min.x && x - r < c.max.x &&
        z + r > c.min.z && z - r < c.max.z &&
        top > c.min.y && y < c.max.y) return true;
  }
  return false;
}
function tryMovePlayer(dx, dz) {
  const nx = player.pos.x + dx;
  const nz = player.pos.z + dz;
  if (!aabbHit(nx, player.pos.y, player.pos.z, player.radius, player.height)) player.pos.x = nx;
  if (!aabbHit(player.pos.x, player.pos.y, nz, player.radius, player.height)) player.pos.z = nz;
}
function resolveVertical(prevY) {
  const wasJumping = player._jumping;
  const r = player.radius, x = player.pos.x, z = player.pos.z, y = player.pos.y;
  let ground = 0;
  for (const c of colliders) {
    if (!(x + r > c.min.x && x - r < c.max.x && z + r > c.min.z && z - r < c.max.z)) continue;
    if (prevY >= c.max.y - 0.01 && y <= c.max.y && c.max.y > ground) ground = c.max.y;
  }
  if (y <= ground) {
    player.pos.y = ground;
    player.vy = 0;
    player.onGround = true;
  } else {
    player.onGround = false;
  }
  snapPlayerToTerrain();
  if (player.onGround && wasJumping) {
    player._jumping = false;
    sendMsg({ type: 'action', action: 'land' });
  }
}

function updatePlayer(dt) {
  if (state.alive && player.pos.y < -8) {
    state.alive = false;
    updateViewModelVisible();
  }
  if (!state.alive) {
    player.moving = false;
    return;
  }
  let fx = 0, fz = 0;
  if (isActionDown('forward')) fz += 1;
  if (isActionDown('back')) fz -= 1;
  if (isActionDown('left')) fx -= 1;
  if (isActionDown('right')) fx += 1;
  fx += touch.moveX;
  fz -= touch.moveY;
  const len = Math.hypot(fx, fz);
  if (len > 1) { fx /= len; fz /= len; }
  const forward = new THREE.Vector3(-Math.sin(player.yaw), 0, -Math.cos(player.yaw));
  const right = new THREE.Vector3(Math.cos(player.yaw), 0, -Math.sin(player.yaw));
  const move = new THREE.Vector3();
  move.addScaledVector(forward, fz);
  move.addScaledVector(right, fx);
  const moveSpeed = player.crouching ? CROUCH_PLAYER_SPEED : player.speed;
  tryMovePlayer(move.x * moveSpeed * dt, 0);
  tryMovePlayer(0, move.z * moveSpeed * dt);
  player.moving = len > 0.05;
  const prevY = player.pos.y;
  player.vy -= GRAVITY * dt;
  player.pos.y += player.vy * dt;
  resolveVertical(prevY);
}
function jump() {
  if (!state.alive || !player.onGround) return;
  if (state.crouching && !setCrouch(false)) return;
  player.vy = JUMP_VELOCITY;
  player.onGround = false;
  player._jumping = true;
  if (state.thirdPerson && playerVRM) {
    setVRMAnimation(playerVRM, 'jump', PHYSICS_JUMP_DURATION);
  }
  sendMsg({ type: 'action', action: 'jump' });
}

/* ==================== [F] 相机 ==================== */
function rayAabbDistance(origin, dir, maxT, min, max) {
  let tmin = 0;
  let tmax = maxT;
  for (const axis of ['x', 'y', 'z']) {
    const o = origin[axis], d = dir[axis];
    const mn = min[axis], mx = max[axis];
    if (Math.abs(d) < 1e-8) {
      if (o < mn || o > mx) return null;
      continue;
    }
    const inv = 1 / d;
    let t1 = (mn - o) * inv;
    let t2 = (mx - o) * inv;
    if (t1 > t2) [t1, t2] = [t2, t1];
    tmin = Math.max(tmin, t1);
    tmax = Math.min(tmax, t2);
    if (tmin > tmax) return null;
  }
  return tmin <= maxT ? Math.max(0, tmin) : null;
}

function getCameraObstacleDistance(start, end, padding = 0.14) {
  const delta = end.clone().sub(start);
  const distance = delta.length();
  if (distance <= 0.001) return distance;
  const dir = delta.multiplyScalar(1 / distance);
  let nearest = distance;
  for (const c of colliders) {
    const min = {
      x: c.min.x - padding, y: c.min.y - padding, z: c.min.z - padding,
    };
    const max = {
      x: c.max.x + padding, y: c.max.y + padding, z: c.max.z + padding,
    };
    const t = rayAabbDistance(start, dir, distance, min, max);
    if (t !== null && t > 0.02 && t < nearest) nearest = t;
  }
  return nearest;
}

function updateCamera() {
  if (state.viewMode === 1 || state.viewMode === 2) {
    const yaw = player.yaw;
    const forward = new THREE.Vector3(-Math.sin(yaw), 0, -Math.cos(yaw));
    const target = player.pos.clone().add(new THREE.Vector3(0, state.crouching ? 1.02 : 1.35, 0));
    const side = state.viewMode === 2 ? 1 : -1;
    const desired = target.clone().addScaledVector(forward, 4 * side);
    desired.y += -Math.sin(player.pitch) * 1.2;

    const safeDistance = getCameraObstacleDistance(target, desired, 0.16);
    const delta = desired.clone().sub(target);
    const actualDistance = Math.max(0.06, Math.min(delta.length(), safeDistance - 0.08));
    camera.position.copy(target).add(delta.normalize().multiplyScalar(actualDistance));
    camera.lookAt(target);
  } else {
    camera.position.set(player.pos.x, player.pos.y + (state.crouching ? 1.35 : 1.7), player.pos.z);
    camera.rotation.set(player.pitch, player.yaw, 0, 'YXZ');
  }
}

const _vrmMixers = new WeakMap();
const _vrmActions = new WeakMap();
const _vrmAnimationState = new WeakMap();
const _vrmCrouchState = new WeakMap();
let _vrmaClips = null;
let _vrmaLoading = null;

// VRMA_07 is a full-body deep-squat exercise animation.  The first squat cycle
// runs roughly from 2.45s (standing) -> 3.45s (deep squat) -> 4.55s (standing).
// We use that real motion for enter/exit and hold the captured crouched pose in
// between so crouching does not repeatedly perform the exercise while held.
const CROUCH_ANIM_ENTER_START = 2.45;
const CROUCH_ANIM_HOLD_TIME = 3.45;
const CROUCH_ANIM_EXIT_END = 4.55;
const CROUCH_ANIM_FADE = 0.08;

function _getMixer(vrm) {
  let mixer = _vrmMixers.get(vrm);
  if (!mixer) {
    mixer = new THREE.AnimationMixer(vrm.scene);
    _vrmMixers.set(vrm, mixer);
  }
  return mixer;
}

async function _loadVRMAClips() {
  if (_vrmaClips) return _vrmaClips;
  if (_vrmaLoading) return _vrmaLoading;

  _vrmaLoading = (async () => {
    const loader = new GLTFLoader();
    loader.register(p => new VRMAnimationLoaderPlugin(p));
    const files = {
      walk: 'CC0-walk.vrma',
      idle: 'VRMA_06.vrma',
      shoot: 'VRMA_04.vrma',
      jump: 'Jump.vrma',
      crouch: 'VRMA_07.vrma',
    };
    const clips = {};

    for (const [key, file] of Object.entries(files)) {
      try {
        const gltf = await new Promise((resolve, reject) =>
          loader.load(ASSET_BASE + 'animations/' + file, resolve, undefined, reject)
        );
        const animations = gltf.userData.vrmAnimations;
        if (animations && animations.length) clips[key] = animations[0];
        else console.warn('[VRMA] 无动画数据:', file);
      } catch (e) {
        console.warn('[VRMA] 加载失败:', file, e?.message || e);
      }
    }

    _vrmaClips = clips;
    console.log('[VRMA] 已加载:', Object.keys(clips).join(', '));
    if (!clips.crouch) console.warn('[VRMA] VRMA_07 深蹲动画未加载，蹲下将退回无动画状态');
    return clips;
  })().finally(() => {
    _vrmaLoading = null;
  });

  return _vrmaLoading;
}

function _getVRMAction(vrm, key) {
  if (!key || !_vrmaClips?.[key]) return null;

  let cache = _vrmActions.get(vrm);
  if (!cache) {
    cache = new Map();
    _vrmActions.set(vrm, cache);
  }

  let action = cache.get(key);
  if (action) return action;

  try {
    const mixer = _getMixer(vrm);
    const clip = createVRMAnimationClip(_vrmaClips[key], vrm);
    action = mixer.clipAction(clip);
  } catch (e) {
    console.error('[VRMA] 创建动作失败:', key, e);
    return null;
  }

  if (key === 'jump' || key === 'crouch') {
    action.setLoop(THREE.LoopOnce, 1);
    action.clampWhenFinished = true;
  } else {
    action.setLoop(THREE.LoopRepeat, Infinity);
    action.clampWhenFinished = false;
  }

  cache.set(key, action);
  return action;
}

function setVRMAnimation(vrm, key, jumpDuration = null) {
  if (!vrm || !_vrmaClips) return;

  const currentKey = _vrmAnimationState.get(vrm) || null;
  if (currentKey === key) return;

  const mixer = _getMixer(vrm);
  const current = currentKey ? _getVRMAction(vrm, currentKey) : null;
  const next = _getVRMAction(vrm, key);

  if (current) {
    current.fadeOut(CROUCH_ANIM_FADE);
    current.paused = false;
  }

  if (!next) {
    _vrmAnimationState.set(vrm, null);
    if (mixer) mixer.stopAllAction();
    if (vrm.humanoid?.resetNormalizedPose) {
      try { vrm.humanoid.resetNormalizedPose(); } catch (e) {}
    }
    return;
  }

  next.reset();
  next.enabled = true;
  next.paused = false;
  next.setEffectiveWeight(1);

  if (key === 'jump') {
    const clipDuration = Math.max(0.01, Number(next.getClip()?.duration) || 1);
    const duration = Math.max(0.25, Number(jumpDuration) || PHYSICS_JUMP_DURATION);
    next.setEffectiveTimeScale(clipDuration / duration);
  } else {
    next.setEffectiveTimeScale(1);
  }

  next.fadeIn(CROUCH_ANIM_FADE);
  next.play();
  _vrmAnimationState.set(vrm, key);
  if (key === 'jump' && !vrm.userData?.__zeroPointJumpReady) {
    if (vrm.userData) vrm.userData.__zeroPointJumpReady = true;
    console.log('[VRMA] Jump Action 已创建并开始播放', next.getClip()?.duration);
  }
}

function _getCrouchState(vrm) {
  let st = _vrmCrouchState.get(vrm);
  if (!st) {
    st = { phase: 'none', action: null };
    _vrmCrouchState.set(vrm, st);
  }
  return st;
}

function _stopCrouchAction(vrm) {
  const st = _vrmCrouchState.get(vrm);
  if (st?.action) {
    st.action.paused = false;
    st.action.stop();
  }
  if (st) {
    st.phase = 'none';
    st.action = null;
  }
  if ((_vrmAnimationState.get(vrm) || null) === 'crouch') {
    _vrmAnimationState.set(vrm, null);
  }
}

function _startCrouchEnter(vrm) {
  const action = _getVRMAction(vrm, 'crouch');
  if (!action) return false;

  // Clear any locomotion action before taking full-body control with VRMA_07.
  setVRMAnimation(vrm, null);

  const st = _getCrouchState(vrm);
  const duration = Math.max(0.01, Number(action.getClip()?.duration) || 0.01);
  const start = Math.min(CROUCH_ANIM_ENTER_START, duration);
  const hold = Math.min(CROUCH_ANIM_HOLD_TIME, duration);

  action.reset();
  action.enabled = true;
  action.paused = false;
  action.setLoop(THREE.LoopOnce, 1);
  action.clampWhenFinished = true;
  action.setEffectiveWeight(1);
  action.setEffectiveTimeScale(1);
  action.time = start;
  action.play();
  _vrmAnimationState.set(vrm, 'crouch');

  st.phase = 'enter';
  st.action = action;
  st.holdTime = hold;
  st.exitEnd = Math.min(CROUCH_ANIM_EXIT_END, duration);
  console.log('[VRMA] Crouch Action 开始', { duration, start, hold: st.holdTime, exitEnd: st.exitEnd });
  return true;
}

function _prepareCrouchAnimation(vrm, enabled) {
  let st = _vrmCrouchState.get(vrm);

  if (enabled) {
    if (!st || st.phase === 'none') {
      _startCrouchEnter(vrm);
      st = _vrmCrouchState.get(vrm);
      return;
    }

    if (!st.action) {
      st.phase = 'none';
      _startCrouchEnter(vrm);
      return;
    }

    // Re-crouching during the exit transition: rewind to the hold point and
    // continue the real squat animation forward into the hold pose.
    if (st.phase === 'exit') {
      st.action.paused = false;
      st.action.setEffectiveTimeScale(1);
      st.action.time = Math.min(Math.max(st.action.time, CROUCH_ANIM_ENTER_START), st.holdTime || CROUCH_ANIM_HOLD_TIME);
      st.phase = 'enter';
    }

    if (st.phase === 'hold') {
      st.action.time = st.holdTime;
      st.action.paused = true;
    }
    return;
  }

  if (!st || st.phase === 'none' || !st.action) return;

  if (st.phase === 'enter' || st.phase === 'hold') {
    st.phase = 'exit';
    st.action.paused = false;
    st.action.setEffectiveTimeScale(1);
    st.action.time = Math.max(st.holdTime || CROUCH_ANIM_HOLD_TIME, Math.min(st.action.time, st.exitEnd || CROUCH_ANIM_EXIT_END));
  }
}

function _finishCrouchAnimation(vrm, enabled) {
  const st = _vrmCrouchState.get(vrm);
  if (!st || !st.action) return false;

  if (enabled) {
    if (st.phase === 'enter' && st.action.time >= st.holdTime) {
      st.action.time = st.holdTime;
      st.action.paused = true;
      st.phase = 'hold';
    } else if (st.phase === 'hold') {
      st.action.time = st.holdTime;
      st.action.paused = true;
    }
    return true;
  }

  if (st.phase === 'exit' && st.action.time >= st.exitEnd) {
    st.action.time = st.exitEnd;
    st.action.paused = true;
    st.action.stop();
    st.phase = 'none';
    st.action = null;
    if ((_vrmAnimationState.get(vrm) || null) === 'crouch') _vrmAnimationState.set(vrm, null);
    return false;
  }
  return true;
}

function updateVRMAvatarAnimation(vrm, { jumping = false, crouching = false, moving = false } = {}, dt = 0) {
  if (!vrm) return;

  if (jumping) {
    _stopCrouchAction(vrm);
    setVRMAnimation(vrm, 'jump', PHYSICS_JUMP_DURATION);
    const mixer = _vrmMixers.get(vrm);
    if (mixer) mixer.update(dt);
    return;
  }

  const hasCrouch = !!_vrmaClips?.crouch;
  if (crouching && hasCrouch) {
    _prepareCrouchAnimation(vrm, true);
    const mixer = _getMixer(vrm);
    mixer.update(dt);
    _finishCrouchAnimation(vrm, true);
    return;
  }

  const crouchStillActive = hasCrouch && _vrmCrouchState.get(vrm)?.phase && _vrmCrouchState.get(vrm).phase !== 'none';
  if (crouchStillActive) {
    _prepareCrouchAnimation(vrm, false);
    const mixer = _getMixer(vrm);
    mixer.update(dt);
    if (_finishCrouchAnimation(vrm, false)) return;
  }

  const desired = moving ? 'walk' : null;
  const pick = desired || ((_vrmaClips && _vrmaClips.idle) ? 'idle' : null);
  setVRMAnimation(vrm, pick, null);
  const mixer = _getMixer(vrm);
  if (mixer) mixer.update(dt);
}

// ===== 第一人称身体裁剪系统（相机在眼睛处，裁掉腰部以上） =====
let fpClipPlane = null;
let _fpClipEnabled = null;

function initFirstPersonClip() {
  if (!fpClipPlane) {
    fpClipPlane = new THREE.Plane(new THREE.Vector3(0, -1, 0), 1.05);
  }
}

function applyFpClip(enabled) {
  if (!playerVRM || !fpClipPlane) return;
  playerVRM.scene.traverse(o => {
    if (o.isMesh && o.material) {
      const mats = Array.isArray(o.material) ? o.material : [o.material];
      for (const m of mats) {
        if (enabled) {
          if (!m.clippingPlanes || m.clippingPlanes.length === 0) {
            m.clippingPlanes = [fpClipPlane];
            m.clipShadows = true;
            m.needsUpdate = true;
          }
        } else {
          if (m.clippingPlanes && m.clippingPlanes.length > 0) {
            m.clippingPlanes = [];
            m.needsUpdate = true;
          }
        }
      }
    }
  });
}

function updateFirstPersonClip() {
  if (!playerVRM) return;
  if (!fpClipPlane) initFirstPersonClip();
  const shouldEnable = state.viewMode === 0 && state.alive;
  if (shouldEnable) {
    const clipY = state.crouching ? 0.8 : 1.05;
    fpClipPlane.constant = player.pos.y + clipY;
  }
  if (_fpClipEnabled !== shouldEnable) {
    _fpClipEnabled = shouldEnable;
    applyFpClip(shouldEnable);
  }
}

function updatePlayerVRM(dt) {
  if (!playerVRM) return;

  // 第一人称也可见（裁剪平面隐藏腰部以上），第三人称全显示
  playerVRM.scene.visible = state.alive;

  playerVRM.scene.position.set(player.pos.x, player.pos.y, player.pos.z);
  playerVRM.scene.rotation.y = player.yaw + VRM_YAW_OFFSET;

  updateVRMAvatarAnimation(playerVRM, {
    jumping: !!player._jumping,
    crouching: !!state.crouching && !player._jumping,
    moving: !!player.moving,
  }, dt);
}

const _bulletGeo = new THREE.SphereGeometry(0.055, 6, 6);
const _bulletMat = new THREE.MeshBasicMaterial({ color: 0xffee66 });

function spawnLocalBullet(origin, dir, remote = false) {
  const mesh = new THREE.Mesh(_bulletGeo, _bulletMat);
  mesh.position.copy(origin);
  scene.add(mesh);
  localBullets.push({ mesh, dir: dir.clone(), speed: 150, life: remote ? 0.75 : 1.0, remote });
}
function updateLocalBullets(dt) {
  for (let i = localBullets.length - 1; i >= 0; i--) {
    const b = localBullets[i];
    b.mesh.position.addScaledVector(b.dir, b.speed * dt);
    b.life -= dt;
    let hitWall = false;
    const p = b.mesh.position;
    for (const c of colliders) {
      if (p.x > c.min.x && p.x < c.max.x && p.y > c.min.y && p.y < c.max.y && p.z > c.min.z && p.z < c.max.z) {
        if (c.isGasTank || c.isBarrel) {
          spawnImpact(p.clone(), 0xffcc33);
          playBeep(520, 0.06, 0.12);
          hitWall = true;
        } else {
          hitWall = true;
          spawnImpact(p.clone(), 0xffddaa);
        }
        break;
      }
    }
    if (hitWall || b.life <= 0) {
      scene.remove(b.mesh);
      localBullets.splice(i, 1);
    }
  }
}

