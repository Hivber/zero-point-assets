function bindPlantBtn() {
  const btn = document.getElementById('plantBtn');
  if (!btn) return;
  let plantTimer = null;
  let holding = false;

  const inZone = () => {
    const dA = Math.hypot(player.pos.x - A_SITE.x, player.pos.z - A_SITE.z);
    const dB = Math.hypot(player.pos.x - B_SITE.x, player.pos.z - B_SITE.z);
    return Math.min(dA, dB) < PLANT_RADIUS + 2.5;
  };

  const start = (e) => {
    if (touchLayoutEditing) return;
    if (e) { e.preventDefault(); e.stopPropagation(); }
    if (!state.c4Held || state.c4Planted) return;
    if (state.holding !== 'c4') return;
    if (!state.alive) return;
    if (!inZone()) return;
    if (holding) return;
    holding = true;
    plantButtonState.holding = true;
    plantButtonState.startedAt = performance.now();
    plantButtonState.progress = 0;
    updatePlantButtonVisualState(true);
    btn.textContent = '安放中…';
    plantTimer = setTimeout(() => {
      if (holding && inZone()) plantC4();
      holding = false;
      plantButtonState.holding = false;
      plantButtonState.progress = 1;
      plantTimer = null;
      updatePlantButtonVisualState(true);
    }, 1500);
  };

  const end = (e) => {
    if (e) { e.preventDefault(); e.stopPropagation(); }
    if (plantTimer) { clearTimeout(plantTimer); plantTimer = null; }
    holding = false;
    plantButtonState.holding = false;
    plantButtonState.startedAt = 0;
    plantButtonState.progress = 0;
    updatePlantButtonVisualState(true);
    btn.textContent = '安放 C4';
  };

  btn.addEventListener('touchstart', start, { passive: false });
  btn.addEventListener('touchend', end, { passive: false });
  btn.addEventListener('touchcancel', end, { passive: false });
  btn.addEventListener('mousedown', start);
  btn.addEventListener('mouseup', end);
  btn.addEventListener('mouseleave', end);
}

