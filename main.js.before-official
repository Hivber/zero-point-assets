const gyro = {
  enabled: false,
  supported: false,
  permission: false,
  source: null,

  biasAlpha: 0,
  biasBeta: 0,
  biasGamma: 0,
  calibrating: false,
  calibrationSamples: [],
  calibrationUntil: 0,

  sensitivity: 1.6,
  deadzone: 0.05,
  smoothing: 0.22,
  maxRate: 720,

  pitchAxis: 'beta',
  yawAxis: 'gamma',
  invertPitch: true,
  invertYaw: false,
  autoCalibrating: false,
  calibSamples: [],
  calibTimer: null,

  filteredYawRate: 0,
  filteredPitchRate: 0,
  lastTs: 0,
  screenAngle: 0
};

function gyroAngleDeg(a, b) {
  let d = a - b;
  while (d > 180) d -= 360;
  while (d < -180) d += 360;
  return d;
}

function getScreenAngle() {
  const a = Number(screen.orientation?.angle);
  if (Number.isFinite(a)) return ((a % 360) + 360) % 360;
  const w = Number(window.orientation);
  if (Number.isFinite(w)) return ((w % 360) + 360) % 360;
  return 0;
}

function remapGyroRates(alpha, beta, gamma) {
  const angle = getScreenAngle();
  let yaw = gamma;
  let pitch = beta;

  if (angle === 90) {
    yaw = -gamma;
    pitch = beta;
  } else if (angle === 270) {
    yaw = gamma;
    pitch = -beta;
  } else if (angle === 180) {
    yaw = -gamma;
    pitch = -beta;
  }

  return { yaw, pitch };
}

function updateGyroButton() {
  const btn = document.getElementById('gyroBtn');
  if (!btn) return;
  btn.classList.toggle('active', gyro.enabled);
  btn.textContent = gyro.calibrating ? '…' : (gyro.enabled ? '📱' : '🎯');
  btn.title = gyro.enabled ? '陀螺仪：已开启（点击关闭）' : '陀螺仪：已关闭（点击开启）';
}

function resetGyroRuntime() {
  gyro.filteredYawRate = 0;
  gyro.filteredPitchRate = 0;
  gyro.lastTs = 0;
  gyro.screenAngle = getScreenAngle();
}

function collectGyroCalibration(alpha, beta, gamma) {
  if (!gyro.calibrating) return;
  gyro.calibrationSamples.push({ alpha, beta, gamma });

  if (performance.now() < gyro.calibrationUntil) return;

  const arr = gyro.calibrationSamples;
  gyro.calibrating = false;
  if (!arr.length) {
    updateGyroButton();
    return;
  }

  const avg = key => arr.reduce((sum, v) => sum + v[key], 0) / arr.length;
  gyro.biasAlpha = avg('alpha');
  gyro.biasBeta = avg('beta');
  gyro.biasGamma = avg('gamma');
  gyro.calibrationSamples.length = 0;
  resetGyroRuntime();
  updateGyroButton();
}

function beginGyroCalibration() {
  if (!gyro.supported) return;
  gyro.calibrating = true;
  gyro.calibrationSamples.length = 0;
  gyro.calibrationUntil = performance.now() + 650;
  resetGyroRuntime();
  updateGyroButton();
}

function handleDeviceMotion(e) {
  if (!gyro.enabled) return;
  const rr = e.rotationRate;
  if (!rr) return;

  const alpha = Number(rr.alpha);
  const beta = Number(rr.beta);
  const gamma = Number(rr.gamma);
  if (![alpha, beta, gamma].every(Number.isFinite)) return;

  gyro.source = 'motion';

  collectGyroCalibration(alpha, beta, gamma);

  const corrected = {
    alpha: Math.max(-gyro.maxRate, Math.min(gyro.maxRate, alpha - gyro.biasAlpha)),
    beta: Math.max(-gyro.maxRate, Math.min(gyro.maxRate, beta - gyro.biasBeta)),
    gamma: Math.max(-gyro.maxRate, Math.min(gyro.maxRate, gamma - gyro.biasGamma))
  };

  let rawYaw = corrected[gyro.yawAxis] || 0;
  let rawPitch = corrected[gyro.pitchAxis] || 0;
  
  if (gyro.invertYaw) rawYaw = -rawYaw;
  if (gyro.invertPitch) rawPitch = -rawPitch;

  let yawRate = Math.abs(rawYaw) < gyro.deadzone ? 0 : rawYaw;
  let pitchRate = Math.abs(rawPitch) < gyro.deadzone ? 0 : rawPitch;

  const k = gyro.smoothing;
  gyro.filteredYawRate += (yawRate - gyro.filteredYawRate) * k;
  gyro.filteredPitchRate += (pitchRate - gyro.filteredPitchRate) * k;

  const now = performance.now();
  const dt = e.interval > 0 ? e.interval / 1000 : (gyro.lastTs ? (now - gyro.lastTs) / 1000 : 1 / 60);
  gyro.lastTs = now;

  if (!state.playing || !state.alive || gyro.calibrating) return;

  player.yaw += gyro.filteredYawRate * dt * Math.PI / 180 * gyro.sensitivity;
  player.pitch += gyro.filteredPitchRate * dt * Math.PI / 180 * gyro.sensitivity;
  player.pitch = Math.max(-1.4, Math.min(1.4, player.pitch));
}

function gyroFallbackOrientation(e) {
  if (!gyro.enabled || gyro.source === 'motion') return;
  const a = Number(e.alpha);
  const b = Number(e.beta);
  const g = Number(e.gamma);
  if (![a, b, g].every(Number.isFinite)) return;

  if (!gyro.source) gyro.source = 'orientation';

  if (!gyro._lastOrientation) {
    gyro._lastOrientation = { alpha: a, beta: b, gamma: g, ts: performance.now() };
    return;
  }

  const last = gyro._lastOrientation;
  const dt = Math.max(1 / 120, Math.min(0.1, (performance.now() - last.ts) / 1000));
  const da = gyroAngleDeg(a, last.alpha) / dt;
  const db = (b - last.beta) / dt;
  const dg = (g - last.gamma) / dt;
  last.alpha = a; last.beta = b; last.gamma = g; last.ts = performance.now();

  const mapped = remapGyroRates(da, db, dg);
  const k = gyro.smoothing;
  let yawRate = Math.abs(mapped.yaw) < gyro.deadzone ? 0 : mapped.yaw;
  let pitchRate = Math.abs(mapped.pitch) < gyro.deadzone ? 0 : mapped.pitch;
  gyro.filteredYawRate += (yawRate - gyro.filteredYawRate) * k;
  gyro.filteredPitchRate += (pitchRate - gyro.filteredPitchRate) * k;

  if (!state.playing || !state.alive) return;
  player.yaw += gyro.filteredYawRate * dt * Math.PI / 180 * gyro.sensitivity;
  player.pitch += gyro.filteredPitchRate * dt * Math.PI / 180 * gyro.sensitivity;
  player.pitch = Math.max(-1.4, Math.min(1.4, player.pitch));
}

async function enableGyro() {
  if (!isTouch) return false;
  if (!('DeviceMotionEvent' in window) && !('DeviceOrientationEvent' in window)) return false;

  try {
    if (typeof DeviceMotionEvent !== 'undefined' && typeof DeviceMotionEvent.requestPermission === 'function') {
      const p = await DeviceMotionEvent.requestPermission();
      if (p !== 'granted') return false;
    }
    if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
      const p = await DeviceOrientationEvent.requestPermission();
      if (p !== 'granted') return false;
    }

    gyro.permission = true;
    gyro.supported = true;
    gyro.source = null;
    
    startGyroAutoCalibration();
    return true;
  } catch (err) {
    console.warn('[GYRO] permission/init failed', err);
    gyro.enabled = false;
    updateGyroButton();
    return false;
  }
}

function disableGyro() {
  gyro.enabled = false;
  gyro.source = null;
  gyro.calibrating = false;
  gyro.calibrationSamples.length = 0;
  gyro._lastOrientation = null;
  resetGyroRuntime();
  window.removeEventListener('devicemotion', handleDeviceMotion);
  window.removeEventListener('deviceorientation', gyroFallbackOrientation);
  updateGyroButton();
}

function toggleGyro() {
  if (gyro.enabled) disableGyro();
  else enableGyro();
}


