function applyOptimizeMode() {
  if (!renderer || !scene) return;

  if (optimizeMode) {
    renderer.setPixelRatio(0.75);
    renderer.shadowMap.enabled = false;
    scene.traverse(o => {
      if (o.isLight && o.castShadow !== undefined) o.castShadow = false;
    });
  } else {
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.shadowMap.enabled = true;
    scene.traverse(o => {
      if (o.isDirectionalLight) o.castShadow = true;
    });
  }

  renderer.setSize(window.innerWidth, window.innerHeight);

  scene.traverse(o => {
    if (o.isMesh && o.material) {
      const mats = Array.isArray(o.material) ? o.material : [o.material];
      for (const m of mats) m.needsUpdate = true;
    }
  });

  const btn = document.getElementById('optBtn');
  if (btn) btn.classList.toggle('active', optimizeMode);
  console.log('[OPT] ' + (optimizeMode ? '优化模式 ON' : '优化模式 OFF'));
