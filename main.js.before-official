function updateImpacts(dt) {
  for (let i = impacts.length - 1; i >= 0; i--) {
    const it = impacts[i];
    it.life -= dt;
    const p = 1 - it.life / it.maxLife;
    const s = 0.15 + p * 0.55;
    it.spr.scale.set(s, s, 1);
    it.spr.material.opacity = 1 - p;
    if (it.life <= 0) {
      scene.remove(it.spr);
      impacts.splice(i, 1);
    }
  }
}

