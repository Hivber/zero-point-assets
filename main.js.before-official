const WEAPON_CLIENT = Object.freeze({
  fireInterval: 110,
  range: 120,
  baseSpreadDeg: 0.10,
  spreadPerShotDeg: 0.18,
  maxSpreadDeg: 2.60,
  movingBonusDeg: 0.75,
  airborneBonusDeg: 1.55,
  burstResetMs: 320,
});

const CLIENT_HITBOXES = Object.freeze([
  { part: 'HEAD',    min: [-0.23, 1.50, -0.23], max: [ 0.23, 1.86,  0.23] },
  { part: 'CHEST',   min: [-0.40, 1.05, -0.28], max: [ 0.40, 1.50,  0.28] },
  { part: 'STOMACH', min: [-0.38, 0.68, -0.27], max: [ 0.38, 1.05,  0.27] },
  { part: 'ARM',     min: [-0.68, 0.78, -0.19], max: [-0.38, 1.43,  0.19] },
  { part: 'ARM',     min: [ 0.38, 0.78, -0.19], max: [ 0.68, 1.43,  0.19] },
  { part: 'LEG',     min: [-0.28, 0.00, -0.24], max: [-0.01, 0.68,  0.24] },
  { part: 'LEG',     min: [ 0.01, 0.00, -0.24], max: [ 0.28, 0.68,  0.24] },
]);

let clientShotSeq = 0;

// ===== 后坐力系统（CF 机制） =====
const RECOIL_CF = {
  V_UP_FAST: 0.0085,
  V_UP_SLOW: 0.0022,
  V_MAX: 0.028,
  V_RECOVER_K: 11,
  H_MAX: 0.0072,
  H_STEP: 0.0028,
  H_RECOVER_K: 7,
  RESET_DELAY: 350,
  RECOVER_DELAY: 150,
};
const recoilCF = {
  accumPitch: 0,
  accumYaw: 0,
  shotIndex: 0,
  lastShotAt: 0,
  hCurrent: 0,
  hDir: 1,
};
function applyWeaponRecoilCF() {
  const now = performance.now();
  const sinceLast = now - recoilCF.lastShotAt;
  if (sinceLast > RECOIL_CF.RESET_DELAY) {
    recoilCF.shotIndex = 0;
    recoilCF.hCurrent = 0;
  }
  recoilCF.lastShotAt = now;

  let vAdd;
  if (recoilCF.shotIndex < 4) vAdd = RECOIL_CF.V_UP_FAST;
  else if (recoilCF.shotIndex < 8) vAdd = RECOIL_CF.V_UP_SLOW;
  else vAdd = 0;
  if (recoilCF.accumPitch + vAdd > RECOIL_CF.V_MAX) {
    vAdd = Math.max(0, RECOIL_CF.V_MAX - recoilCF.accumPitch);
  }
  player.pitch += vAdd;
  recoilCF.accumPitch += vAdd;

  if (recoilCF.shotIndex >= 4) {
    if (Math.random() < 0.5) recoilCF.hDir *= -1;
    const step = recoilCF.hDir * Math.random() * RECOIL_CF.H_STEP;
    recoilCF.hCurrent += step;
    if (Math.abs(recoilCF.hCurrent) > RECOIL_CF.H_MAX) {
      recoilCF.hCurrent = Math.sign(recoilCF.hCurrent) * RECOIL_CF.H_MAX;
    }
    player.yaw += recoilCF.hCurrent;
    recoilCF.accumYaw += recoilCF.hCurrent;
  }

  recoilCF.shotIndex++;
  player.pitch = Math.max(-1.4, Math.min(1.4, player.pitch));

  if (gunModel) {
    gunModel.userData._recoilZ = (gunModel.userData._recoilZ || 0) + 0.055;
    gunModel.userData._recoilRotX = (gunModel.userData._recoilRotX || 0) + 0.04;
  }
}
function updateWeaponRecoilCF(dt) {
  const now = performance.now();
  if (now - recoilCF.lastShotAt >= RECOIL_CF.RECOVER_DELAY) {
    if (recoilCF.accumPitch > 1e-5) {
      const k = 1 - Math.exp(-RECOIL_CF.V_RECOVER_K * dt);
      const r = recoilCF.accumPitch * k;
      player.pitch -= r;
      recoilCF.accumPitch -= r;
    } else recoilCF.accumPitch = 0;

    if (Math.abs(recoilCF.accumYaw) > 1e-5) {
      const k = 1 - Math.exp(-RECOIL_CF.H_RECOVER_K * dt);
      const r = recoilCF.accumYaw * k;
      player.yaw -= r;
      recoilCF.accumYaw -= r;
    } else recoilCF.accumYaw = 0;

    if (now - recoilCF.lastShotAt > 500) {
      recoilCF.hCurrent *= Math.exp(-8 * dt);
    }
  }

  if (gunModel) {
    const baseZ = gunModel.userData._baseZ;
    const baseRotX = gunModel.userData._baseRotX;
    if (baseZ !== undefined && baseRotX !== undefined) {
      gunModel.userData._recoilZ = (gunModel.userData._recoilZ || 0) * Math.exp(-14 * dt);
      gunModel.userData._recoilRotX = (gunModel.userData._recoilRotX || 0) * Math.exp(-14 * dt);
      gunModel.position.z = baseZ + gunModel.userData._recoilZ;
      gunModel.rotation.x = baseRotX + gunModel.userData._recoilRotX;
    }
  }
}

let clientBurstShots = 0;
let clientLastShotAt = 0;

function mulberry32Client(seed) {
  let a = seed >>> 0;
  return function rand() {
    a |= 0;
    a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function shotSeedClient(playerId, shotSeq) {
  return (Math.imul(playerId >>> 0, 0x9E3779B1) ^ Math.imul(shotSeq >>> 0, 0x85EBCA77)) >>> 0;
}
function getClientSpread(moving, airborne, crouching = false) {
  const now = performance.now();
  const since = clientLastShotAt ? now - clientLastShotAt : Infinity;
  const burstIndex = since <= WEAPON_CLIENT.burstResetMs ? clientBurstShots : 0;
  clientBurstShots = since <= WEAPON_CLIENT.burstResetMs ? clientBurstShots + 1 : 1;
  clientLastShotAt = now;
  const baseSpread = crouching ? CROUCH_BASE_SPREAD_DEG : WEAPON_CLIENT.baseSpreadDeg;
  const burstSpread = burstIndex * WEAPON_CLIENT.spreadPerShotDeg * (crouching ? CROUCH_SPREAD_BURST_SCALE : 1);
  const movementSpread = crouching ? 0 : (moving ? WEAPON_CLIENT.movingBonusDeg : 0);
  const airborneSpread = crouching ? 0 : (airborne ? WEAPON_CLIENT.airborneBonusDeg : 0);
  return Math.max(
    baseSpread,
    Math.min(
      WEAPON_CLIENT.maxSpreadDeg,
      baseSpread + burstSpread + movementSpread + airborneSpread
    )
  );
}

function applySpreadClient(yaw, pitch, spreadDeg, shotSeq) {
  const cp = Math.cos(pitch);
  const forward = new THREE.Vector3(-Math.sin(yaw) * cp, Math.sin(pitch), -Math.cos(yaw) * cp).normalize();
  const right = new THREE.Vector3(Math.cos(yaw), 0, -Math.sin(yaw)).normalize();
  const up = new THREE.Vector3().crossVectors(right, forward).normalize();
  const rnd = mulberry32Client(shotSeedClient(myId, shotSeq));
  const radius = Math.sqrt(rnd());
  const angle = rnd() * Math.PI * 2;
  const tanSpread = Math.tan(spreadDeg * Math.PI / 180);
  const c = Math.cos(angle) * tanSpread * radius;
  const s2 = Math.sin(angle) * tanSpread * radius;
  return forward.clone().addScaledVector(right, c).addScaledVector(up, s2).normalize();
}

function getAimRay() {
  const yaw = player.yaw;
  const pitch = player.pitch;
  const cp = Math.cos(pitch);
  const dir = new THREE.Vector3(-Math.sin(yaw) * cp, Math.sin(pitch), -Math.cos(yaw) * cp).normalize();
  return { yaw, pitch, dir };
}

function getShotOrigin() {
  return player.pos.clone().add(new THREE.Vector3(0, state.thirdPerson ? (state.crouching ? 0.98 : 1.25) : (state.crouching ? 1.35 : 1.65), 0));
}

function worldToOtherLocal(origin, dir, op) {
  const dx = origin.x - op.group.position.x;
  const dz = origin.z - op.group.position.z;
  const c = Math.cos(op.group.rotation.y);
  const s = Math.sin(op.group.rotation.y);
  return {
    origin: new THREE.Vector3(dx * c - dz * s, origin.y - op.group.position.y, dx * s + dz * c),
    dir: new THREE.Vector3(dir.x * c - dir.z * s, dir.y, dir.x * s + dir.z * c),
  };
}

function predictLocalHit(origin, dir) {
  let nearestWall = WEAPON_CLIENT.range;
  for (const c of colliders) {
    const min = { x: c.min.x, y: c.min.y, z: c.min.z };
    const max = { x: c.max.x, y: c.max.y, z: c.max.z };
    const t = rayAabbDistance(origin, dir, WEAPON_CLIENT.range, min, max);
    if (t !== null && t > 0.02 && t < nearestWall) nearestWall = t;
  }

  let best = null;
  for (const op of otherPlayers.values()) {
    if (!op.visible || !op.alive) continue;
    const ray = worldToOtherLocal(origin, dir, op);
    for (const hb of CLIENT_HITBOXES) {
      const min = { x: hb.min[0], y: hb.min[1], z: hb.min[2] };
      const max = { x: hb.max[0], y: hb.max[1], z: hb.max[2] };
      const t = rayAabbDistance(ray.origin, ray.dir, nearestWall, min, max);
      if (t === null) continue;
      if (!best || t < best.distance) best = { distance: t, part: hb.part };
    }
  }
  return best;
}

function playerShoot() {
  if (!state.playing || !state.alive) return;
  if (state.reloading) return;
  if (state.shootCd > 0) return;
  if (state.holding !== 'gun') return;
  if (state.ammo <= 0) { reload(); return; }

  state.shootCd = WEAPON_CLIENT.fireInterval / 1000;
  state.ammo--;
  if (state.ammo <= 0) reload();
  playGunSound();

  const aim = getAimRay();
  const shotSeq = ++clientShotSeq;
  const moving = player.moving;
  const airborne = !player.onGround;
  const spreadDeg = getClientSpread(moving, airborne, state.crouching);
  const dir = applySpreadClient(aim.yaw, aim.pitch, spreadDeg, shotSeq);
  const origin = getShotOrigin();

  spawnLocalBullet(origin, dir, false);
  const predicted = predictLocalHit(origin, dir);
  if (predicted) showHitMarker(predicted.part === 'HEAD', predicted.part, true);

  sendShoot(aim.yaw, aim.pitch, shotSeq, moving, airborne, state.thirdPerson, state.crouching);

  applyWeaponRecoilCF();
  updateAmmoUI();
}

function reload() {
  if (state.reloading || state.holding === 'c4') return;
  if (!state.alive) return;
  if (state.ammo >= state.magSize) return;
  if (state.reloadTimer) clearTimeout(state.reloadTimer);
  state.reloading = true;
  state.reloadStartedAt = performance.now();
  playReloadSound();
  updateAmmoUI();
  sendMsg({ type: 'action', action: 'reload' });
  state.reloadTimer = setTimeout(() => {
    state.reloadTimer = null;
    if (!state.playing || !state.alive) {
      state.reloading = false;
      updateAmmoUI();
      return;
    }
    state.ammo = state.magSize;
    state.reloading = false;
    updateAmmoUI();
  }, 1800);
}

function switchWeapon() {
  if (!state.playing) return;
  if (state.holding === 'none') return;
  if (state.c4Held && !state.c4Planted) {
    state.holding = state.holding === 'gun' ? 'c4' : 'gun';
  } else {
    state.holding = 'gun';
  }
  if (state.holding === 'c4' && state.reloading) {
    if (state.reloadTimer) clearTimeout(state.reloadTimer);
    state.reloadTimer = null;
    state.reloading = false;
  }
  updateViewModelVisible();
  const btn = document.getElementById('switchBtn');
  if (btn) btn.textContent = state.holding === 'gun' ? '💣' : '🔫';
  const wn = document.getElementById('weaponName');
  if (wn) wn.textContent = state.holding === 'gun' ? 'AK47' : 'C4';
  sendMsg({ type: 'action', action: 'switch_gun', data: { weapon: state.holding } });
}

function updateViewButton() {
  const btn = document.getElementById('viewBtn');
  if (!btn) return;
  const labels = ['主视角（第一人称）', '背视角（第三人称）', '正视角（第三人称）'];
  const icons = ['👁️', '👤', '🧑'];
  const label = labels[state.viewMode] || labels[0];
  btn.title = label + ' · 点击切换';
  btn.setAttribute('aria-label', label + ' · 点击切换');
  btn.textContent = icons[state.viewMode] || icons[0];
}

function toggleView() {
  // 三视角循环：主视角 → 背视角 → 正视角 → 主视角。
  state.viewMode = (state.viewMode + 1) % 3;
  state.thirdPerson = state.viewMode !== 0;
  updateViewModelVisible();
  updateViewButton();
}

function updateViewModelVisible() {
  const showFp = state.alive && !state.thirdPerson;
  if (gunModel) gunModel.visible = showFp && state.holding === 'gun';
  if (c4HandModel) c4HandModel.visible = showFp && state.holding === 'c4';
}

/* ==================== [I] C4 操作 ==================== */
function dropC4() { /* 按当前玩法保留为空：C4 不支持玩家主动丢弃 */ }
function tryPickC4() { /* 按当前玩法保留为空：C4 不支持拾取 */ }
function plantC4() {
  if (!state.c4Held || state.c4Planted || state.c4PlantPending) return;
  if (state.holding !== 'c4') return;
  if (!state.alive) return;
  if (maintenanceMode || !protocolCompatible || !versionCompatible) return;
  const dA = Math.hypot(player.pos.x - A_SITE.x, player.pos.z - A_SITE.z);
  const dB = Math.hypot(player.pos.x - B_SITE.x, player.pos.z - B_SITE.z);
  if (Math.min(dA, dB) > PLANT_RADIUS + 2.5) {
    console.log('不在 A/B 点内，无法下包');
    return;
  }
  // TRUST 模式：本地立即生效，不等服务端 ack
  const requestId = createRequestId('c4');
  state.c4Held = false;
  state.c4Planted = true;
  state.holding = 'gun';
  state.c4EndAt = Date.now() + 40000;
  state.c4PlantPending = false;
  state.c4PlantRequestId = null;
  updateViewModelVisible();
  const btn = document.getElementById('plantBtn');
  if (btn) { btn.textContent = '已安放'; btn.disabled = true; setTimeout(() => { btn.textContent = '按住安放'; btn.disabled = false; }, 1000); }
  // 通知服务端（服务端 TRUST 模式直接广播）
  sendMsg({
    type: 'plant_c4',
    requestId,
    x: player.pos.x,
    y: player.pos.y,
    z: player.pos.z,
  });
}

function sendUnstuck() {
  if (!state.playing || !state.alive) return;
  if (state.c4Planted) return;  // 已经下包了，别再自杀
  const btn = document.getElementById('unstuckBtn');
  if (btn) {
    if (btn.classList.contains('busy')) return;
    btn.classList.add('busy');
    btn.textContent = '…';
    setTimeout(() => {
      if (btn.classList.contains('busy')) {
        btn.classList.remove('busy');
        btn.textContent = '💀';
      }
    }, 600);
  }
  sendMsg({ type: 'unstuck' });
}

function updateCrouchButton() {
  const btn = document.getElementById('crouchBtn');
  if (!btn) return;
  btn.classList.toggle('active', state.crouching);
  btn.textContent = state.crouching ? '🧎' : '🧎‍♂️';
  btn.title = state.crouching ? '起身' : '蹲下';
}

function setCrouch(enabled, notify = true) {
  enabled = !!enabled;
  if (!state.playing || !state.alive) return false;
  if (enabled) {
    if (player._jumping || !player.onGround) return false;
    if (state.crouching) return true;
  } else {
    if (!state.crouching) return false;
    // 头顶空间不足时不强制站起，避免穿透墙体/天花板。
    if (aabbHit(player.pos.x, player.pos.y, player.pos.z, player.radius, NORMAL_PLAYER_HEIGHT)) return false;
  }

  state.crouching = enabled;
  player.crouching = enabled;
  player.height = enabled ? CROUCH_PLAYER_HEIGHT : NORMAL_PLAYER_HEIGHT;
  updateCrouchButton();
  if (notify) sendMsg({ type: 'action', action: 'crouch', data: { enabled } });
  return true;
}

/* ==================== [J] 输入 ==================== */
function setupInput() {
  document.addEventListener('keydown', (e) => {
    // 正在修改键位时，键盘输入只用于捕获新键，不触发游戏动作。
    if (rebindingAction) {
      e.preventDefault();
      e.stopPropagation();
      applyRebind(e.code);
      return;
    }
    keys[e.code] = true;
    if (e.repeat) return;
    if (e.code === keybinds.reload) reload();
    if (e.code === keybinds.view) toggleView();
    if (e.code === keybinds.crouch) setCrouch(!state.crouching);
    if (e.code === keybinds.switchWeapon) switchWeapon();
    if (e.code === keybinds.drop) dropC4();
    if (e.code === keybinds.pickup) tryPickC4();
    if (e.code === keybinds.plant && state.holding === 'c4') plantC4();
    if (e.code === keybinds.jump) { e.preventDefault(); jump(); }
  });
  document.addEventListener('keyup', (e) => { keys[e.code] = false; });

  if (!isTouch) {
    renderer.domElement.addEventListener('click', () => {
      if (state.playing && document.pointerLockElement !== renderer.domElement) {
        renderer.domElement.requestPointerLock();
      }
    });
    document.addEventListener('mousemove', (e) => {
      if (document.pointerLockElement === renderer.domElement) {
        player.yaw -= e.movementX * 0.0025;
        player.pitch -= e.movementY * 0.0025;
        player.pitch = Math.max(-1.4, Math.min(1.4, player.pitch));
      }
    });
    document.addEventListener('mousedown', (e) => {
      if (e.button === 0 && document.pointerLockElement === renderer.domElement) mouse.held = true;
    });
    document.addEventListener('mouseup', (e) => { if (e.button === 0) mouse.held = false; });
    document.getElementById('viewBtn').addEventListener('click', (e) => { e.stopPropagation(); toggleView(); });
    document.getElementById('crouchBtn').addEventListener('click', (e) => { e.stopPropagation(); setCrouch(!state.crouching); });
    document.getElementById('exitBtn').addEventListener('click', (e) => { e.stopPropagation(); exitToMenu(); });
  } else {
    setupTouch();
  }
}

const touchRoles = new Map();
const touchLookRef = new Map();
const fireIds = new Set();
function roleAt(cx, cy) {
  const el = document.elementFromPoint(cx, cy);
  if (el) {
    if (el.closest('#fireBtn')) return 'fire';
    if (el.closest('#jumpBtn')) return 'jump';
    if (el.closest('#crouchBtn')) return 'crouch';
    if (el.closest('#reloadBtn2')) return 'reload';
    if (el.closest('#switchBtn')) return 'switch';
    if (el.closest('#dropBtn')) return 'drop';
    if (el.closest('#viewBtn')) return 'viewBtn';
    if (el.closest('#exitBtn')) return 'exitBtn';
    if (el.closest('#gyroBtn')) return 'gyroBtn';
    if (el.closest('#unstuckBtn')) return 'unstuckBtn';
    if (el.closest('#joystick')) return 'joy';
    if (el.closest('#touchLayoutHudBtn')) return 'touchLayoutBtn';
    if (el.closest('#keybindPanel')) return 'keybindUI';
  }
  if (cx < window.innerWidth * 0.45) return 'joy';
  return 'look';
}
function setupTouch() {
  setTouchControlsVisible(false);
  const applyLook = (id, x, y) => {
    const last = touchLookRef.get(id);
    if (!last) return;
    const dx = x - last.x, dy = y - last.y;
    touchLookRef.set(id, { x, y });
    player.yaw -= dx * 0.005;
    player.pitch -= dy * 0.005;
    player.pitch = Math.max(-1.4, Math.min(1.4, player.pitch));
  };
  const joyEl = document.getElementById('joystick');
  const stickEl = document.getElementById('stick');
  const joyCenter = () => {
    const r = joyEl.getBoundingClientRect();
    return { x: r.left + r.width/2, y: r.top + r.height/2, max: r.width * 0.36 };
  };
  function updateJoy(t) {
    const c = joyCenter();
    let dx = t.clientX - c.x, dy = t.clientY - c.y;
    const len = Math.hypot(dx, dy);
    if (len > c.max) { dx = dx / len * c.max; dy = dy / len * c.max; }
    touch.moveX = dx / c.max;
    touch.moveY = dy / c.max;
    stickEl.style.transform = `translate(${dx}px, ${dy}px)`;
  }
  function resetJoy() {
    touch.moveX = 0; touch.moveY = 0;
    stickEl.style.transform = '';
  }

  document.addEventListener('touchstart', (e) => {
    if (touchLayoutEditing) return;
    if (!state.playing) return;
    for (const t of e.changedTouches) {
      if (touchRoles.has(t.identifier)) continue;
      const role = roleAt(t.clientX, t.clientY);
      touchRoles.set(t.identifier, role);
      if (role === 'joy') updateJoy(t);
      else if (role === 'look' || role === 'fire') {
        touchLookRef.set(t.identifier, { x: t.clientX, y: t.clientY });
        if (role === 'fire') {
          fireIds.add(t.identifier);
          touch.fire = true;
          playerShoot();
        }
      } else if (role === 'jump') jump();
      else if (role === 'crouch') setCrouch(!state.crouching);
      else if (role === 'reload') reload();
      else if (role === 'switch') switchWeapon();
      else if (role === 'drop') dropC4();
      else if (role === 'viewBtn') toggleView();
      else if (role === 'exitBtn') exitToMenu();
      else if (role === 'gyroBtn') toggleGyro();
      else if (role === 'unstuckBtn') sendUnstuck();
      else if (role === 'touchLayoutBtn') openTouchLayoutPanel();
      // 键位设置面板和触控布局编辑器需要保留浏览器的 click/pointer 事件，不能在 touchstart 时阻止默认行为。
      if (role !== 'keybindUI' && role !== 'touchLayoutBtn') e.preventDefault();
    }
  }, { passive: false });

  document.addEventListener('touchmove', (e) => {
    for (const t of e.changedTouches) {
      const role = touchRoles.get(t.identifier);
      if (!role) continue;
      if (role === 'joy') { updateJoy(t); e.preventDefault(); }
      else if (role === 'look' || role === 'fire') {
        applyLook(t.identifier, t.clientX, t.clientY);
        e.preventDefault();
      }
    }
  }, { passive: false });

  const endHandler = (e) => {
    for (const t of e.changedTouches) {
      const role = touchRoles.get(t.identifier);
      if (role === 'joy') resetJoy();
      if (role === 'fire') {
        fireIds.delete(t.identifier);
        if (fireIds.size === 0) touch.fire = false;
      }
      touchRoles.delete(t.identifier);
      touchLookRef.delete(t.identifier);
    }
  };
  document.addEventListener('touchend', endHandler);
  document.addEventListener('touchcancel', endHandler);
}


/* ==================== [MOBILE] Canvas Tactical HUD ==================== */
/*
 * 性能版：不再使用一个覆盖整块屏幕的透明 Canvas。
 * 每个按钮使用一个独立的小 Canvas，只在状态/布局变化时重绘。
 * 这样能避免透明全屏 Canvas 持续参与 GPU 合成，同时保持 Canvas 视觉质量。
 */
const MOBILE_HUD = {
  canvas: null,          // 兼容旧代码：保留，但始终隐藏
  ctx: null,
  layer: null,
  sprites: new Map(),
  spriteSigs: new Map(),
  rectCache: new Map(),
  layoutDirty: true,
  initialized: false,
  dpr: 1,
};

function invalidateMobileHudCache() {
  MOBILE_HUD.rectCache.clear();
  MOBILE_HUD.spriteSigs.clear();
  MOBILE_HUD.layoutDirty = true;
}

function mobileHudQualityDpr() {
  // 手机端也拉满 DPR：canvas 尺寸大一点，但每个按钮 canvas 很小，内存可控。
  return Math.min(window.devicePixelRatio || 1, 3);
}

function mobileHudInit() {
  if (MOBILE_HUD.initialized) return;
  const fullCanvas = document.getElementById('mobileHudCanvas');
  if (fullCanvas) {
    fullCanvas.classList.add('hidden');
    fullCanvas.setAttribute('aria-hidden', 'true');
  }

  let layer = document.getElementById('mobileHudLayer');
  if (!layer) {
    layer = document.createElement('div');
    layer.id = 'mobileHudLayer';
    layer.setAttribute('aria-hidden', 'true');
    document.body.appendChild(layer);
  }
  MOBILE_HUD.canvas = fullCanvas;
  MOBILE_HUD.layer = layer;
  MOBILE_HUD.initialized = true;
  invalidateMobileHudCache();
}

function resizeMobileHudCanvas() {
  mobileHudInit();
  MOBILE_HUD.dpr = mobileHudQualityDpr();
  invalidateMobileHudCache();
}

function mobileHudVisible() {
  return isTouch && (state.playing || touchLayoutEditing);
}

function setMobileCanvasHudMode(on) {
  if (!isTouch) return;
  mobileHudInit();
  const enabled = !!on;
  document.body.classList.toggle('mobile-canvas-hud', enabled);
  if (MOBILE_HUD.canvas) MOBILE_HUD.canvas.classList.add('hidden');
  if (MOBILE_HUD.layer) {
    MOBILE_HUD.layer.classList.toggle('hidden', !enabled);
    MOBILE_HUD.layer.style.display = enabled ? 'block' : 'none';
  }
  if (!enabled) {
    for (const canvas of MOBILE_HUD.sprites.values()) canvas.style.display = 'none';
  }
}

function mobileHudRect(id) {
  const el = document.getElementById(id);
  if (!el) return null;
  if (el.classList.contains('hidden')) return null;
  const cached = MOBILE_HUD.rectCache.get(id);
  if (cached) return cached;
  const r = el.getBoundingClientRect();
  if (!r.width || !r.height) return null;
  const out = {
    x: r.left, y: r.top, w: r.width, h: r.height,
    cx: r.left + r.width / 2, cy: r.top + r.height / 2,
  };
  MOBILE_HUD.rectCache.set(id, out);
  return out;
}

function mobileHudIsElementVisible(id) {
  const el = document.getElementById(id);
  if (!el || el.classList.contains('hidden')) return false;
  return !!mobileHudRect(id);
}

function mobileHudEnsureSprite(id) {
  mobileHudInit();
  let canvas = MOBILE_HUD.sprites.get(id);
  if (canvas) return canvas;
  canvas = document.createElement('canvas');
  canvas.className = 'mobile-hud-sprite';
  canvas.dataset.hudId = id;
  canvas.setAttribute('aria-hidden', 'true');
  MOBILE_HUD.layer.appendChild(canvas);
  MOBILE_HUD.sprites.set(id, canvas);
  return canvas;
}

function mobileHudDrawSprite(id, drawFn) {
  const canvas = mobileHudEnsureSprite(id);
  const r = mobileHudRect(id);
  if (!r || !mobileHudIsElementVisible(id)) {
    canvas.style.display = 'none';
    return null;
  }

  const dpr = MOBILE_HUD.dpr || mobileHudQualityDpr();
  const needW = Math.max(1, Math.round(r.w * dpr));
  const needH = Math.max(1, Math.round(r.h * dpr));
  if (canvas.width !== needW || canvas.height !== needH) {
    canvas.width = needW;
    canvas.height = needH;
  }
  canvas.style.display = 'block';
  canvas.style.left = `${Math.round(r.x)}px`;
  canvas.style.top = `${Math.round(r.y)}px`;
  canvas.style.width = `${Math.max(1, Math.round(r.w))}px`;
  canvas.style.height = `${Math.max(1, Math.round(r.h))}px`;

  const ctx = canvas.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.imageSmoothingEnabled = true;
  ctx.imageSmoothingQuality = 'high';
  try { ctx.textRendering = 'geometricPrecision'; } catch (e) {}
  ctx.clearRect(0, 0, r.w, r.h);
  const local = { x: 0, y: 0, w: r.w, h: r.h, cx: r.w / 2, cy: r.h / 2 };
  const oldCtx = MOBILE_HUD.ctx;
  MOBILE_HUD.ctx = ctx;
  try { drawFn(local, ctx); } finally { MOBILE_HUD.ctx = oldCtx; }
  return canvas;
}

function mobileHudRoundRect(c, x, y, w, h, r) {
  const rr = Math.min(r, w * 0.5, h * 0.5);
  c.beginPath();
  c.moveTo(x + rr, y);
  c.arcTo(x + w, y, x + w, y + h, rr);
  c.arcTo(x + w, y + h, x, y + h, rr);
  c.arcTo(x, y + h, x, y, rr);
  c.arcTo(x, y, x + w, y, rr);
  c.closePath();
}

function mobileHudHexPath(c, cx, cy, r, yScale = 1) {
  c.beginPath();
  for (let i = 0; i < 8; i++) {
    const a = -Math.PI / 8 + i * Math.PI / 4;
    const x = cx + Math.cos(a) * r;
    const y = cy + Math.sin(a) * r * yScale;
    if (i === 0) c.moveTo(x, y); else c.lineTo(x, y);
  }
  c.closePath();
}

function mobileHudPressed(id) {
  if (id === 'fireBtn') return fireIds.size > 0 || touch.fire;
  if (id === 'crouchBtn') return !!state.crouching;
  if (id === 'joystick') return Math.abs(touch.moveX) > 0.06 || Math.abs(touch.moveY) > 0.06;
  return false;
}

function mobileHudPalette(kind, pressed = false) {
  // PUBG Mobile 风格：中性、低对比、半透明；仅关键状态使用轻微色彩强调。
  const base = {
    utility: { fill:'rgba(18,24,30,.24)', ring:'rgba(235,244,248,.58)', icon:'rgba(245,250,252,.92)', accent:'rgba(255,255,255,.18)' },
    blue:    { fill:'rgba(24,42,58,.24)', ring:'rgba(170,220,245,.64)', icon:'rgba(241,249,255,.94)', accent:'rgba(130,205,240,.20)' },
    gold:    { fill:'rgba(58,46,20,.22)', ring:'rgba(244,211,129,.68)', icon:'rgba(255,247,219,.96)', accent:'rgba(244,211,129,.18)' },
    red:     { fill:'rgba(75,22,24,.22)', ring:'rgba(255,150,144,.70)', icon:'rgba(255,242,241,.96)', accent:'rgba(255,98,90,.20)' },
    green:   { fill:'rgba(18,58,37,.22)', ring:'rgba(150,238,190,.66)', icon:'rgba(241,255,247,.96)', accent:'rgba(100,230,155,.18)' },
    cyan:    { fill:'rgba(17,53,60,.22)', ring:'rgba(154,231,242,.66)', icon:'rgba(239,255,255,.96)', accent:'rgba(113,222,241,.18)' },
  }[kind] || { fill:'rgba(18,24,30,.24)', ring:'rgba(235,244,248,.58)', icon:'rgba(245,250,252,.92)', accent:'rgba(255,255,255,.18)' };
  if (!pressed) return base;
  return {
    fill: kind === 'red' ? 'rgba(125,30,32,.42)' : 'rgba(235,245,250,.24)',
    ring: base.icon,
    icon: '#ffffff',
    accent: base.ring,
  };
}

function mobileHudVisualAlpha(opacity, emphasis = 1) {
  const op = Math.max(0.2, Math.min(1, Number(opacity ?? 1)));
  const editorBoost = touchLayoutEditing ? 1.25 : 1;
  return Math.max(0.22, Math.min(0.82, op * 0.58 * editorBoost * emphasis));
}

function mobileHudDrawTacticalButton(r, opts = {}) {
  if (!r) return;
  const c = MOBILE_HUD.ctx;
  const cx = r.cx, cy = r.cy;
  const radius = Math.min(r.w, r.h) * 0.5;
  const kind = opts.kind || 'utility';
  const pressed = !!opts.pressed;
  const pal = mobileHudPalette(kind, pressed);
  const alpha = mobileHudVisualAlpha(opts.opacity, pressed ? 1.05 : 1);

  c.save();
  c.globalAlpha = alpha;
  c.fillStyle = pal.fill;
  c.beginPath(); c.arc(cx, cy, radius * 0.90, 0, Math.PI * 2); c.fill();

  c.globalAlpha = Math.min(0.9, alpha * 1.28);
  c.strokeStyle = pal.ring;
  c.lineWidth = Math.max(1.25, radius * 0.028);
  c.beginPath(); c.arc(cx, cy, radius * 0.80, 0, Math.PI * 2); c.stroke();

  c.globalAlpha = Math.min(0.65, alpha * 0.72);
  c.strokeStyle = pal.accent;
  c.lineWidth = Math.max(1, radius * 0.012);
  c.beginPath(); c.arc(cx, cy, radius * 0.69, 0, Math.PI * 2); c.stroke();
  c.restore();
}

function mobileHudDrawCircleButton(r, opts = {}) {
  if (!r) return;
  const c = MOBILE_HUD.ctx;
  const cx = r.cx, cy = r.cy;
  const radius = Math.min(r.w, r.h) * 0.5;
  const kind = opts.kind || 'utility';
  const pal = mobileHudPalette(kind, !!opts.pressed);
  const alpha = mobileHudVisualAlpha(opts.opacity, 0.92);
  c.save();
  c.globalAlpha = alpha;
  c.fillStyle = pal.fill;
  c.beginPath(); c.arc(cx, cy, radius * 0.84, 0, Math.PI * 2); c.fill();
  c.globalAlpha = Math.min(0.82, alpha * 1.22);
  c.strokeStyle = pal.ring;
  c.lineWidth = Math.max(1.1, radius * 0.026);
  c.beginPath(); c.arc(cx, cy, radius * 0.74, 0, Math.PI * 2); c.stroke();
  c.restore();
}

function mobileHudIconCrosshair(cx, cy, r, color) {
  const c = MOBILE_HUD.ctx;
  c.save();
  c.strokeStyle = color; c.lineWidth = Math.max(1.3, r * 0.055); c.lineCap = 'round';
  for (const [a,b] of [[-1,-.25],[1,-.25],[-1,.25],[1,.25]]) {
    const x1=cx+a*r, x2=cx+a*r*.38;
    const y1=cy+b*r, y2=cy+b*r;
    c.beginPath(); c.moveTo(x1,y1); c.lineTo(x2,y2); c.stroke();
  }
  c.beginPath(); c.arc(cx, cy, r*.16, 0, Math.PI*2); c.stroke();
  c.restore();
}

function mobileHudDrawIcon(id, r, opts = {}) {
  if (!r) return;
  const c = MOBILE_HUD.ctx;
  const cx = r.cx, cy = r.cy;
  const base = Math.min(r.w, r.h);
  const s = base * .21;
  const color = opts.color || '#f3f8fa';
  c.save();
  c.strokeStyle = color; c.fillStyle = color;
  c.lineWidth = Math.max(1.4, base * .021); c.lineCap = 'round'; c.lineJoin = 'round';

  if (id === 'fireBtn') {
    mobileHudIconCrosshair(cx, cy-s*.06, s*.9, color);
  } else if (id === 'reloadBtn2') {
    c.beginPath(); c.arc(cx,cy,s*.82,-.45,Math.PI*1.45); c.stroke();
    c.beginPath(); c.moveTo(cx+s*.60,cy-s*.64); c.lineTo(cx+s*.84,cy-s*.34); c.lineTo(cx+s*.40,cy-s*.31); c.stroke();
    c.strokeRect(cx-s*.18,cy-s*.54,s*.30,s*1.08);
  } else if (id === 'jumpBtn') {
    c.beginPath(); c.moveTo(cx,cy-s*.86); c.lineTo(cx-s*.52,cy-s*.18); c.moveTo(cx,cy-s*.86); c.lineTo(cx+s*.52,cy-s*.18); c.stroke();
    c.beginPath(); c.moveTo(cx,cy-s*.83); c.lineTo(cx,cy+s*.76); c.stroke();
    c.beginPath(); c.moveTo(cx-s*.46,cy+s*.46); c.lineTo(cx,cy+s*.76); c.lineTo(cx+s*.46,cy+s*.46); c.stroke();
  } else if (id === 'crouchBtn') {
    c.beginPath(); c.arc(cx,cy-s*.55,s*.24,0,Math.PI*2); c.fill();
    c.beginPath(); c.moveTo(cx-s*.08,cy-s*.24); c.lineTo(cx-s*.48,cy+s*.05); c.lineTo(cx-s*.08,cy+s*.28); c.lineTo(cx+s*.58,cy+s*.28); c.stroke();
    c.beginPath(); c.moveTo(cx-s*.08,cy+s*.28); c.lineTo(cx-s*.40,cy+s*.64); c.moveTo(cx+s*.18,cy+s*.28); c.lineTo(cx+s*.52,cy+s*.62); c.stroke();
  } else if (id === 'switchBtn') {
    c.beginPath(); c.moveTo(cx-s*.78,cy-s*.26); c.lineTo(cx+s*.42,cy-s*.26); c.stroke();
    c.beginPath(); c.moveTo(cx+s*.22,cy-s*.50); c.lineTo(cx+s*.66,cy-s*.26); c.lineTo(cx+s*.22,cy-s*.02); c.stroke();
    c.beginPath(); c.moveTo(cx+s*.78,cy+s*.26); c.lineTo(cx-s*.42,cy+s*.26); c.stroke();
    c.beginPath(); c.moveTo(cx-s*.22,cy+s*.02); c.lineTo(cx-s*.66,cy+s*.26); c.lineTo(cx-s*.22,cy+s*.50); c.stroke();
  } else if (id === 'viewBtn') {
    c.beginPath(); c.moveTo(cx-s*1.05,cy); c.quadraticCurveTo(cx,cy-s*.64,cx+s*1.05,cy); c.quadraticCurveTo(cx,cy+s*.64,cx-s*1.05,cy); c.stroke();
    c.beginPath(); c.arc(cx,cy,s*.23,0,Math.PI*2); c.stroke();
  } else if (id === 'gyroBtn') {
    c.beginPath(); c.arc(cx,cy,s*.76,0,Math.PI*2); c.stroke();
    c.beginPath(); c.moveTo(cx,cy-s*.92); c.lineTo(cx,cy-s*.45); c.moveTo(cx-s*.92,cy); c.lineTo(cx-s*.45,cy); c.stroke();
    c.beginPath(); c.arc(cx,cy,s*.24,0,Math.PI*2); c.stroke();
  } else if (id === 'optBtn') {
    c.beginPath(); c.moveTo(cx-s*.18,cy-s*.92); c.lineTo(cx+s*.48,cy-s*.05); c.lineTo(cx+s*.06,cy-s*.04); c.lineTo(cx+s*.18,cy+s*.92); c.lineTo(cx-s*.48,cy+s*.05); c.lineTo(cx-s*.06,cy+s*.04); c.closePath(); c.stroke();
  } else if (id === 'unstuckBtn') {
    c.beginPath(); c.arc(cx,cy,s*.76,0,Math.PI*2); c.stroke();
    c.beginPath(); c.moveTo(cx-s*.36,cy-s*.36); c.lineTo(cx+s*.36,cy+s*.36); c.moveTo(cx+s*.36,cy-s*.36); c.lineTo(cx-s*.36,cy+s*.36); c.stroke();
  } else if (id === 'keybindHudBtn') {
    c.strokeRect(cx-s*.86,cy-s*.55,s*1.72,s*1.10);
    for(let row=0;row<2;row++) for(let col=0;col<4;col++) c.strokeRect(cx-s*.67+col*s*.39,cy-s*.36+row*s*.37,s*.24,s*.18);
  } else if (id === 'touchLayoutHudBtn') {
    c.strokeRect(cx-s*.78,cy-s*.62,s*1.56,s*1.24);
    c.beginPath(); c.moveTo(cx-s*.52,cy-s*.28); c.lineTo(cx-s*.10,cy-s*.28); c.moveTo(cx+s*.10,cy-s*.28); c.lineTo(cx+s*.52,cy-s*.28); c.moveTo(cx-s*.52,cy+s*.22); c.lineTo(cx+s*.52,cy+s*.22); c.stroke();
  } else if (id === 'plantBtn') {
    c.strokeRect(cx-s*.48,cy-s*.55,s*.96,s*1.10);
    c.beginPath(); c.moveTo(cx-s*.48,cy-s*.18); c.lineTo(cx+s*.48,cy-s*.18); c.stroke();
    c.beginPath(); c.arc(cx,cy+s*.22,s*.26,0,Math.PI*2); c.stroke();
  } else if (id === 'exitBtn') {
    c.beginPath(); c.moveTo(cx-s*.50,cy-s*.50); c.lineTo(cx+s*.50,cy+s*.50); c.moveTo(cx+s*.50,cy-s*.50); c.lineTo(cx-s*.50,cy+s*.50); c.stroke();
  }
  c.restore();
}

function mobileHudDrawReloadRing(r, opacity) {
  const progress = state.reloading ? Math.max(0, Math.min(1, state.reloadProgress || 0)) : 0;
  if (progress <= 0) return;
  const c = MOBILE_HUD.ctx;
  const radius = Math.min(r.w, r.h) * 0.5;
  const cx = r.cx, cy = r.cy;
  const alpha = mobileHudVisualAlpha(opacity, 1.25);
  c.save();
  c.globalAlpha = alpha;
  c.strokeStyle = 'rgba(255,255,255,.22)';
  c.lineWidth = Math.max(2.4, radius * 0.085);
  c.lineCap = 'round';
  c.beginPath(); c.arc(cx, cy, radius * 0.94, 0, Math.PI * 2); c.stroke();
  c.globalAlpha = Math.min(1, alpha * 1.35);
  c.strokeStyle = '#7fe9ff';
  c.lineWidth = Math.max(2.4, radius * 0.085);
  c.beginPath();
  c.arc(cx, cy, radius * 0.94, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * progress);
  c.stroke();
  c.restore();
}

function mobileHudDrawLabel(r, label, color = 'rgba(245,250,252,.82)') {
  if (!r || !label) return;
  const c=MOBILE_HUD.ctx; const base=Math.min(r.w,r.h);
  c.save();
  c.font=`700 ${Math.max(12,Math.min(15,base*.12))}px -apple-system,"PingFang SC","Helvetica Neue","Microsoft YaHei",sans-serif`;
  c.textAlign='center'; c.textBaseline='middle'; c.fillStyle=color;
  c.fillText(label,r.cx,r.y+r.h*.78);
  c.restore();
}

function mobileHudDrawJoystick(r) {
  const c=MOBILE_HUD.ctx;
  const radius=Math.min(r.w,r.h)*.5;
  const cx=r.cx, cy=r.cy;
  const kx=cx+(touch.moveX||0)*radius*.40;
  const ky=cy+(touch.moveY||0)*radius*.40;
  const knobR=Math.min(28,radius*.30);
  const alpha=touchLayoutEditing ? .58 : .34;
  c.save();
  c.globalAlpha=alpha;
  c.fillStyle='rgba(16,22,27,.42)'; c.beginPath(); c.arc(cx,cy,radius*.88,0,Math.PI*2); c.fill();
  c.strokeStyle='rgba(238,246,250,.72)'; c.lineWidth=Math.max(1.2,radius*.022); c.stroke();
  c.globalAlpha=alpha*.55;
  c.beginPath(); c.arc(cx,cy,radius*.64,0,Math.PI*2); c.stroke();
  c.globalAlpha=Math.min(.72,alpha+0.22);
  c.fillStyle='rgba(214,233,240,.18)'; c.beginPath(); c.arc(kx,ky,knobR,0,Math.PI*2); c.fill();
  c.strokeStyle='rgba(245,251,253,.78)'; c.lineWidth=Math.max(1.2,radius*.026); c.stroke();
  c.restore();
}

function mobileHudTouchOpacity(id) {
  const cfg = touchLayoutEditing ? touchLayoutWorking?.[id] : touchConfigForUser(id);
  const n = Number(cfg?.opacity);
  return Number.isFinite(n) ? Math.max(0.2, Math.min(1, n)) : 1;
}

function mobileHudDrawPlantSprite(r) {
  if (!r) return;
  const c = MOBILE_HUD.ctx;
  const op = mobileHudTouchOpacity('plantBtn');
  const progress = Math.max(0, Math.min(1, plantButtonState.progress || 0));
  const radius = Math.min(r.w, r.h) * 0.5;
  const alpha=mobileHudVisualAlpha(op,1.10);
  c.save();
  c.globalAlpha=alpha;
  c.fillStyle=plantButtonState.holding ? 'rgba(128,30,32,.40)' : 'rgba(82,24,26,.24)';
  c.beginPath(); c.arc(r.cx,r.cy,radius*.90,0,Math.PI*2); c.fill();
  c.strokeStyle=plantButtonState.holding ? '#ffd9d5' : 'rgba(255,155,149,.78)';
  c.lineWidth=Math.max(1.4,radius*.028);
  c.beginPath(); c.arc(r.cx,r.cy,radius*.79,0,Math.PI*2); c.stroke();
  c.globalAlpha=Math.min(.72,alpha*.90);
  c.strokeStyle='rgba(255,255,255,.16)';
  c.lineWidth=Math.max(1,radius*.012);
  c.beginPath(); c.arc(r.cx,r.cy,radius*.68,0,Math.PI*2); c.stroke();
  c.restore();

  if (progress > 0) {
    c.save();
    c.strokeStyle='#fff4f0'; c.lineWidth=Math.max(2,radius*.042);
    c.beginPath(); c.arc(r.cx,r.cy,radius*.79,-Math.PI/2,-Math.PI/2+Math.PI*2*progress); c.stroke();
    c.restore();
  }
  mobileHudDrawIcon('plantBtn',r,{color:'#fff0ee'});
  c.save();
  c.fillStyle='#fff4f1'; c.font=`700 ${Math.max(9,Math.min(13,Math.min(r.w,r.h)*.095))}px system-ui,sans-serif`;
  c.textAlign='center'; c.textBaseline='middle';
  c.fillText(plantButtonState.holding ? `安装 ${Math.round(progress*100)}%` : '安装 C4', r.cx, r.y+r.h*.77);
  c.restore();
}

function mobileHudSpriteSignature(id) {
  const cfg = touchLayoutEditing ? touchLayoutWorking?.[id] : touchConfigForUser(id);
  const visible = document.getElementById(id)?.classList.contains('hidden') ? 0 : 1;
  const x = cfg ? `${Math.round(cfg.x*1000)}:${Math.round(cfg.y*1000)}:${Math.round((cfg.scale||1)*100)}:${Math.round((cfg.opacity||1)*100)}:${cfg.visible!==false?1:0}` : '';
  let dynamic='';
  if (id==='fireBtn') dynamic=`f:${touch.fire?1:0}:${fireIds.size}`;
  else if (id==='joystick') dynamic=`m:${Math.round((touch.moveX||0)*28)}:${Math.round((touch.moveY||0)*28)}`;
  else if (id==='crouchBtn') dynamic=`c:${state.crouching?1:0}`;
  else if (id==='reloadBtn2') dynamic=`r:${state.reloading?1:0}:${Math.round((state.reloadProgress||0)*60)}`;
  else if (id==='viewBtn') dynamic=`v:${state.viewMode}`;
  else if (id==='gyroBtn') dynamic=`g:${gyro.enabled?1:0}`;
  else if (id==='switchBtn') dynamic=`s:${state.holding}`;
  else if (id==='plantBtn') dynamic=`p:${plantButtonState.holding?1:0}:${Math.round((plantButtonState.progress||0)*30)}`;
  else if (id==='optBtn') dynamic=`o:${optimizeMode?1:0}`;
  const selected = touchLayoutEditing ? (getTouchWorkingSelected()?.id || '') : '';
  return `${visible}|${x}|${dynamic}|e:${selected}`;
}

function mobileHudDrawSpriteById(id) {
  const visible = mobileHudIsElementVisible(id);
  if (!visible) {
    const canvas=mobileHudEnsureSprite(id); canvas.style.display='none';
    return;
  }
  const sig=mobileHudSpriteSignature(id);
  if (MOBILE_HUD.spriteSigs.get(id)===sig && !MOBILE_HUD.layoutDirty) return;
  MOBILE_HUD.spriteSigs.set(id,sig);

  const kindById = {
    exitBtn:'red', viewBtn:'blue', gyroBtn:'cyan', optBtn:'gold', unstuckBtn:'gold',
    keybindHudBtn:'utility', touchLayoutHudBtn:'gold', fireBtn:'red', reloadBtn2:'blue',
    jumpBtn:'green', crouchBtn:'cyan', switchBtn:'gold'
  };
  const labels = {
    exitBtn:'退出',
