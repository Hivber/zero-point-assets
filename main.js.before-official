/* ==================== 地形渲染（服务端下发高度图） ==================== */
let terrainMesh = null;
let terrainWater = null;
let terrainHeightData = null;

function decodeHeightMap(b64) {
  const bin = atob(b64);
  const bytes = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
  return new Int16Array(bytes.buffer);
}

function sampleTerrainHeight(x, z) {
  if (!terrainHeightData || !terrainMesh) return 0;
  const t = terrainMesh.userData;
  const size = t.size, segments = t.segments;
  const half = size / 2;
  const gx = ((x + half) / size) * segments;
  const gz = ((z + half) / size) * segments;
  const x0 = Math.max(0, Math.min(segments - 1, Math.floor(gx)));
  const z0 = Math.max(0, Math.min(segments - 1, Math.floor(gz)));
  const x1 = Math.min(segments, x0 + 1);
  const z1 = Math.min(segments, z0 + 1);
  const fx = gx - x0, fz = gz - z0;
  const cols = segments + 1;
  const h00 = terrainHeightData[z0 * cols + x0] / 100;
  const h10 = terrainHeightData[z0 * cols + x1] / 100;
  const h01 = terrainHeightData[z1 * cols + x0] / 100;
  const h11 = terrainHeightData[z1 * cols + x1] / 100;
  const h0 = h00 + (h10 - h00) * fx;
  const h1 = h01 + (h11 - h01) * fx;
  return h0 + (h1 - h0) * fz;
}

function buildTerrainFromServer(terrainData) {
  if (terrainMesh) { scene.remove(terrainMesh); terrainMesh.geometry.dispose(); terrainMesh = null; }
  if (terrainWater) { scene.remove(terrainWater); terrainWater.geometry.dispose(); terrainWater = null; }

  const size = terrainData.size;
  const segments = terrainData.segments;
  const waterLevel = terrainData.waterLevel;
  terrainHeightData = decodeHeightMap(terrainData.heightB64);

  const geometry = new THREE.PlaneGeometry(size, size, segments, segments);
  geometry.rotateX(-Math.PI / 2);

  const pos = geometry.attributes.position;
  let minH = Infinity, maxH = -Infinity;
  for (let i = 0; i < pos.count; i++) {
    const h = terrainHeightData[i] / 100;
    pos.setY(i, h);
    if (h < minH) minH = h;
    if (h > maxH) maxH = h;
  }
  geometry.computeVertexNormals();

  const material = new THREE.MeshStandardMaterial({
    color: 0x6a8a4a, roughness: 0.95, metalness: 0.05
  });

  terrainMesh = new THREE.Mesh(geometry, material);
  terrainMesh.receiveShadow = true;
  terrainMesh.castShadow = true;
  terrainMesh.userData = { size: size, segments: segments };
  scene.add(terrainMesh);

  scene.add(new THREE.HemisphereLight(0xf5e0b0, 0x605040, 0.85));
  const sun = new THREE.DirectionalLight(0xfff0d0, 1.8);
  sun.position.set(50, 90, 30);
  sun.castShadow = true;
  sun.shadow.mapSize.set(1024, 1024);
  sun.shadow.camera.far = 500;
  scene.add(sun);

  if (Number.isFinite(waterLevel) && waterLevel > minH) {
    const wg = new THREE.PlaneGeometry(size, size);
    wg.rotateX(-Math.PI / 2);
    const wm = new THREE.MeshStandardMaterial({
      color: 0x2a6a9a, transparent: true, opacity: 0.75,
      roughness: 0.1, metalness: 0.3
    });
    terrainWater = new THREE.Mesh(wg, wm);
    terrainWater.position.y = waterLevel;
    scene.add(terrainWater);
  }

  console.log('🏔️ 地形已构建：' + (segments + 1) + '×' + (segments + 1) + '，高度 ' + minH.toFixed(1) + ' ~ ' + maxH.toFixed(1));
}

function snapPlayerToTerrain() {
  if (!terrainHeightData) return;
  const ground = sampleTerrainHeight(player.pos.x, player.pos.z);
  if (player.pos.y < ground) {
    player.pos.y = ground;
    player.vy = 0;
    player.onGround = true;
  }
}

