function collectDeviceInfo() {
  const info = {
    ua: (navigator.userAgent || '').slice(0, 200),
    platform: navigator.platform || '',
    lang: navigator.language || '',
    screen: window.screen ? (window.screen.width + 'x' + window.screen.height) : '',
    dpr: window.devicePixelRatio || 1,
  };
  const nb = window.NativeBridge || window.ZeroPointNative || null;
  if (nb) {
    info.hasBridge = true;
    // 尝试多个常见方法名
    const fnNames = ['getDeviceInfo','deviceInfo','getDeviceModel','getModel','getSystemInfo','getAppVersion','getDeviceId'];
    for (const name of fnNames) {
      if (typeof nb[name] === 'function') {
        try {
          const r = nb[name]();
          if (r && typeof r === 'object') {
            for (const k in r) if (info[k] === undefined) info[k] = r[k];
          } else if (typeof r === 'string' && r.length < 100) {
            info[name] = r;
          }
        } catch (e) {}
      }
    }
    // 通配调用（如果桥接有 call 方法）
    if (typeof nb.call === 'function') {
      const tryKeys = ['model','brand','osVersion','androidVersion','deviceId','imei'];
      for (const k of tryKeys) {
        try {
          const r = nb.call('getDeviceInfo', k);
          if (r && typeof r !== 'object' && String(r).length < 100) info[k] = String(r);
        } catch (e) {}
      }
    }
  } else {
    info.hasBridge = false;
  }
  return info;
}

function getConfiguredWebSocketUrl() {
  const candidates = [];
  try {
    const query = new URLSearchParams(location.search || '');
    const queryValue = query.get('ws') || query.get('websocket') || query.get('server');
    if (queryValue) candidates.push(queryValue.trim());
  } catch (e) {}

  try {
    const globals = [
      window.__ZP_WS_URL__,
      window.__ZERO_POINT_WS_URL__,
      window.ZERO_POINT_WS_URL,
    ];
    for (const value of globals) {
      if (typeof value === 'string' && value.trim()) candidates.push(value.trim());
    }
  } catch (e) {}

  try {
    const saved = localStorage.getItem('zp.wsUrl');
    if (saved) candidates.push(saved.trim());
  } catch (e) {}

  return candidates;
}

function normalizeWebSocketUrl(raw) {
  if (!raw) return null;
  let value = String(raw).trim();
  if (!value) return null;
  try {
    if (value.startsWith('http://')) value = 'ws://' + value.slice(7);
    else if (value.startsWith('https://')) value = 'wss://' + value.slice(8);
    if (!(value.startsWith('ws://') || value.startsWith('wss://'))) return null;
    const u = new URL(value);
    if (!u.hostname) return null;
    u.hash = '';
    return u.toString();
  } catch (e) {
    return null;
  }
}

function buildWebSocketCandidates() {
  const raw = getConfiguredWebSocketUrl();
  const urls = [];
  const add = (value) => {
    const normalized = normalizeWebSocketUrl(value);
    if (normalized && !urls.includes(normalized)) urls.push(normalized);
  };

  // 显式地址优先：适用于 Android 套壳 APP、反向代理和远程服务器。
  raw.forEach(add);

  // 浏览器正常访问 HTTP/HTTPS 时，优先沿用当前站点，避免硬编码服务器地址。
  if (location.protocol === 'http:' || location.protocol === 'https:') {
    const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
    add(proto + '//' + location.host);
  } else {
    // file:// / 自定义 WebView scheme 没有可靠的 location.host。
    // 这类套壳 APP 默认尝试本机 9178，同时仍支持上面的显式 ws= 地址。
    add('ws://127.0.0.1:9178');
    add('ws://localhost:9178');
  }

  return urls;
}

let wsCandidates = [];
