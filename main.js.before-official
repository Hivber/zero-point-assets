  try {
    const socket = new WebSocket(url);
    ws = socket;

    timeout = setTimeout(() => {
      if (generation !== socketGeneration) return;
      if (socket.readyState === WebSocket.CONNECTING) {
        const msg = '连接超时：' + url;
        wsLastError = msg;
        setLoading(8, msg);
        setMenuNetStatus('连接超时，正在重试…');
        try { socket.close(4000, 'connect timeout'); } catch (e) {}
      } else if (socket.readyState === WebSocket.OPEN && !welcomeReceived) {
        const msg = '服务器未完成握手：' + url;
        wsLastError = msg;
        setLoading(8, msg);
        setMenuNetStatus('服务器握手超时，正在重试…');
        try { socket.close(4001, 'welcome timeout'); } catch (e) {}
      }
    }, 7000);

    socket.onopen = () => {
      if (generation !== socketGeneration) return;
      reconnectAttempt = 0;
      setMenuNetStatus('已连接，正在同步状态…');
      setLoading(8, '服务器已连接，正在同步状态…');
      (async () => {
