    setLoading(8, msg);
    setMenuNetStatus(msg);
    if (initialConnectResolve) scheduleInitialRetry(true);
    return;
  }

  const url = wsCandidates[wsCandidateIndex % wsCandidates.length];
  currentWsUrl = url;
  wsCandidateIndex = (wsCandidateIndex + 1) % wsCandidates.length;
  const generation = ++socketGeneration;
  let welcomeReceived = false;
