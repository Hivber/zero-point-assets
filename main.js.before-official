let assetTotalBytes = 0;
let assetLoadedBytes = 0;
let _assetLastPaint = 0;
let _assetSpeed = 0;
const _assetSpeedSamples = [];
const _assetSpeedLastPaint = { t: 0, b: 0 };
function _assetUpdateSpeed() {
  const now = performance.now();
  if (_assetSpeedLastPaint.t && now - _assetSpeedLastPaint.t >= 400) {
    const dt = (now - _assetSpeedLastPaint.t) / 1000;
    const db = assetLoadedBytes - _assetSpeedLastPaint.b;
    if (dt > 0.05 && db >= 0) {
      const inst = db / dt;
      _assetSpeed = _assetSpeed > 0 ? _assetSpeed * 0.6 + inst * 0.4 : inst;
    }
    _assetSpeedLastPaint.t = now;
    _assetSpeedLastPaint.b = assetLoadedBytes;
  } else if (!_assetSpeedLastPaint.t) {
    _assetSpeedLastPaint.t = now;
    _assetSpeedLastPaint.b = assetLoadedBytes;
  }
}
function paintAssetProgress(force) {
  const now = performance.now();
  if (!force && now - _assetLastPaint < 80) return;
  _assetLastPaint = now;
  _assetUpdateSpeed();
  const st = document.getElementById('loadingStatus');
  if (!st) return;
  const loadedMB = (assetLoadedBytes / 1048576).toFixed(2);
  const totalMB = assetTotalBytes > 0 ? (assetTotalBytes / 1048576).toFixed(2) : '??.??';
  const speedMB = (_assetSpeed / 1048576).toFixed(2);
  st.textContent = '(' + loadedMB + 'MB/' + totalMB + 'MB)  ' + speedMB + 'MB/s';
}
(function hookAssetProgress() {
  if (window.__zpAssetHooked) return;
  window.__zpAssetHooked = true;
  const _orig = window.fetch;
  window.fetch = function (input, init) {
    const url = typeof input === 'string' ? input : (input && input.url) || '';
    const p = _orig.call(this, input, init);
    if (!url || !/\.(glb|gltf|bin|jpe?g|png|webp|hdr|vrma|vrm|mp3|wav)(\?|$)/i.test(url)) return p;
    return p.then((res) => {
      if (!res.ok || !res.body) return res;
      const [s1, s2] = res.body.tee();
      (async () => {
        const reader = s1.getReader();
        try {
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            assetLoadedBytes += (value && value.byteLength) || 0;
            paintAssetProgress(false);
          }
        } catch (e) {}
      })();
      return new Response(s2, { status: res.status, statusText: res.statusText, headers: res.headers });
    });
  };
})();

