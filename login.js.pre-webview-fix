(function () {
  'use strict';

  const $ = (id) => document.getElementById(id);
  let mode = 'login';
  let busy = false;

  function setMode(next) {
    mode = next;
    const isRegister = mode === 'register';
    $('tabLogin').classList.toggle('active', !isRegister);
    $('tabRegister').classList.toggle('active', isRegister);
    $('nicknameRow').classList.toggle('hidden', !isRegister);
    $('submitBtn').textContent = isRegister ? '建立特勤档案' : '进入行动系统';
    $('formTitle').textContent = isRegister ? '创建账号' : '欢迎回来，玩家';
    $('formHint').textContent = isRegister ? '注册后即可进入行动大厅' : '使用你的零点行动账号进入行动大厅';
    $('nickname').required = isRegister;
    clearMessage();
  }

  function showMessage(text, good) {
    const el = $('message');
    el.textContent = text || '';
    el.classList.toggle('good', !!good);
    el.classList.toggle('bad', !good);
  }

  function clearMessage() {
    const el = $('message');
    el.textContent = '';
    el.className = 'message';
  }

  function saveAuth(data) {
    localStorage.setItem('zp_token', data.token);
    localStorage.setItem('zp_user', JSON.stringify(data.user));
    localStorage.removeItem('zeroPoint.session');
    localStorage.removeItem('zp_session_token');
  }

  async function checkExistingSession() {
    const token = localStorage.getItem('zp_token');
    if (!token) return;
    try {
      const res = await fetch('/api/me', {
        headers: { Authorization: 'Bearer ' + token },
        cache: 'no-store',
      });
      const data = await res.json().catch(() => ({ ok: false }));
      if (data.ok && data.user) {
        localStorage.setItem('zp_user', JSON.stringify(data.user));
        window.location.replace('/index.html');
      } else {
        localStorage.removeItem('zp_token');
        localStorage.removeItem('zp_user');
      }
    } catch (e) {
      // 登录页不在服务器可达时强制跳转，保持当前页面可重试。
    }
  }

  async function submitForm(event) {
    event.preventDefault();
    if (busy) return;

    const username = $('username').value.trim();
    const password = $('password').value;
    const nickname = $('nickname').value.trim();

    if (!/^[a-zA-Z0-9_]{3,20}$/.test(username)) {
      return showMessage('用户名需为3-20位字母、数字或下划线', false);
    }
    if (password.length < 6 || password.length > 128) {
      return showMessage('密码长度需为6-128位', false);
    }
    if (mode === 'register' && nickname.length > 24) {
      return showMessage('昵称不能超过24个字符', false);
    }

    busy = true;
    $('submitBtn').disabled = true;
    $('submitBtn').textContent = mode === 'register' ? '注册中…' : '登录中…';
    clearMessage();

    try {
      const body = mode === 'register'
        ? { username, password, nickname: nickname || username }
        : { username, password };
      const res = await fetch('/api/' + mode, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        cache: 'no-store',
      });
      const data = await res.json().catch(() => ({ ok: false, msg: '服务器返回异常' }));
      if (!data.ok || !data.token || !data.user) {
        showMessage(data.msg || '操作失败，请稍后重试', false);
        return;
      }

      saveAuth(data);
      showMessage(mode === 'register' ? '注册成功，正在进入游戏…' : '登录成功，正在进入游戏…', true);
      setTimeout(() => window.location.replace('/index.html'), 220);
    } catch (e) {
      showMessage('网络错误，无法连接服务器', false);
    } finally {
      busy = false;
      $('submitBtn').disabled = false;
      $('submitBtn').textContent = mode === 'register' ? '创建账号' : '登录';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    $('tabLogin').addEventListener('click', () => setMode('login'));
    $('tabRegister').addEventListener('click', () => setMode('register'));
    $('authForm').addEventListener('submit', submitForm);
    setMode('login');
    checkExistingSession();
  });
})();
